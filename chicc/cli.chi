// chicc/chicc/cli.chi
// Task 4I.1: CLI Entry Point for the Chi self-hosting compiler
// Provides cliMain(args) that handles argument parsing, file I/O,
// stdlib loading, and dispatching to compile or run modes.
package chicc/cli
import std/lang { luaExpr, embedLua }
import std/os { getEnv }
import std/io.file { readString, open, close, write }
import chicc/compiler { newLuaCompilationEnv, newReplCompilationEnv, compileToLua, compileReplLine, commitReplLine, saveReplMetadata, restoreReplMetadata, formatMessage, ReplNamedFn }
import chicc/types { Type, sumListTypes }

// ============================================================================
// Diagnostics output
// ============================================================================

// stdlib has no stderr writer. stdout is flushed first so diagnostics keep
// their place relative to program output when both streams share a pipe.
fn eprintln(msg: string) {
    embedLua("io.stdout:flush(); io.stderr:write(msg, '\\n')")
}

// ============================================================================
// Stdlib loading
// ============================================================================

// Load the standard library from CHI_HOME/lib/std.chim, unless the launcher
// already loaded one and set _CHI_STDLIB_LOADED (the native binary embeds it).
// Prints the error and returns false when std.chim cannot be loaded.
pub fn loadStdlib(): bool {
    if luaExpr("_CHI_STDLIB_LOADED == true") as bool {
        return true
    }
    val chiHome = getEnv("CHI_HOME")
    if chiHome == unit {
        eprintln("Error: CHI_HOME not set, cannot load the standard library")
        return false
    }
    val libPath = "${chiHome}/lib/std.chim"
    val code = readSource(libPath)
    if code == unit {
        eprintln("Error: cannot read $libPath")
        return false
    }
    embedLua("local chunk, err = load(code, '@' .. libPath)")
    val loadErr: any = luaExpr("err")
    if loadErr != unit {
        val errStr = luaExpr("tostring(err)") as string
        eprintln("Error loading $libPath: $errStr")
        return false
    }
    embedLua("local ok, runErr = pcall(chunk)")
    val runOk = luaExpr("ok") as bool
    if runOk == false {
        val runErrStr = luaExpr("tostring(runErr)") as string
        eprintln("Error loading $libPath: $runErrStr")
        return false
    }
    true
}

// ============================================================================
// Helpers
// ============================================================================

fn printMessages(messages: any, msgCount: int) {
    var i = 1
    while i <= msgCount {
        val msg: any = luaExpr("messages[i]")
        val formatted = formatMessage(msg)
        eprintln(formatted)
        i = i + 1
    }
}

// readString crashes on a missing file and returns nil for a directory.
fn readSource(path: string): string | unit {
    val f = open(path, "r")
    if f == unit {
        return unit
    }
    close(f)
    readString(path)
}

// ============================================================================
// Compile mode: source -> Lua file
// ============================================================================

// Prints the diagnostics and returns unit when inputPath cannot be read or compiled.
fn compileSource(inputPath: string): string | unit {
    val source = readSource(inputPath)
    if source == unit {
        eprintln("Error: cannot read $inputPath")
        return unit
    }
    val ns = newLuaCompilationEnv()
    val result = compileToLua(source as string, ns)
    val luaCode: any = luaExpr("result.luaCode")
    val messages: any = luaExpr("result.messages")
    val msgCount = luaExpr("#messages") as int
    if luaCode == unit {
        printMessages(messages, msgCount)
        eprintln("Compilation failed.")
        return unit
    }
    luaCode as string
}

pub fn compileFile(inputPath: string, outputPath: string): int {
    val luaCode = compileSource(inputPath)
    if luaCode == unit {
        return 1
    }
    val out = open(outputPath, "w")
    if out == unit {
        eprintln("Error: cannot write $outputPath")
        return 1
    }
    write(out, luaCode as string)
    close(out)
    println("Compiled: $inputPath -> $outputPath")
    0
}

// ============================================================================
// Run mode: compile + execute
// ============================================================================

pub fn runFile(inputPath: string): int {
    val source = readSource(inputPath)
    if source == unit {
        eprintln("Error: cannot read $inputPath")
        return 1
    }
    val ns = newLuaCompilationEnv()
    val result = compileToLua(source as string, ns)
    val luaCode: any = luaExpr("result.luaCode")
    val messages: any = luaExpr("result.messages")
    val msgCount = luaExpr("#messages") as int
    if luaCode == unit {
        printMessages(messages, msgCount)
        eprintln("Compilation failed.")
        1
    } else {
        // Load and execute the compiled Lua code
        embedLua("local chunk, err = load(luaCode, inputPath)")
        val loadErr: any = luaExpr("err")
        if loadErr != unit {
            val errStr = luaExpr("tostring(err)") as string
            eprintln("Lua load error: $errStr")
            return 1
        }
        embedLua("local ok, runErr = pcall(chunk)")
        val runOk = luaExpr("ok") as bool
        if runOk == false {
            val runErrStr = luaExpr("tostring(runErr)") as string
            eprintln("Runtime error: $runErrStr")
            return 1
        }
        0
    }
}

// ============================================================================
// Argument parsing helpers
// ============================================================================

// Helper to resolve output path from input path (replace .chi with .lua)
fn defaultOutputPath(inputPath: string): string {
    val suffix = inputPath.byteSub(inputPath.byteLen() - 3, inputPath.byteLen())
    if suffix == ".chi" {
        val base = inputPath.byteSub(1, inputPath.byteLen() - 4)
        "$base.lua"
    } else {
        "$inputPath.lua"
    }
}

// Helper to check file extension
fn hasExtension(path: string, ext: string): bool {
    val extLen = ext.byteLen()
    val neg: int = 0 - extLen
    val suffix = path.byteSub(neg, path.byteLen())
    suffix == ext
}

// ============================================================================
// Usage help
// ============================================================================

val CHI_VERSION = "0.1.0"

fn printUsage(out: (string) -> unit) {
    out("Usage: chi <command> [options] [file]")
    out("")
    out("Commands:")
    out("  repl                        Start interactive REPL")
    out("  compile [-o OUTPUT] FILE    Compile .chi to .lua")
    out("  build [-o OUTPUT] FILE      Build standalone native executable")
    out("  FILE                        Compile and run .chi")
    out("  (no arguments)              Start interactive REPL")
    out("")
    out("Options:")
    out("  -o, --output FILE           Output file path (compile and build)")
    out("  -h, --help                  Show this help")
    out("  --version                   Show version")
}

type FileArgs = { input: string, output: string }

// Parses `[-o OUTPUT] FILE` after the command word. Prints the error and
// returns unit on bad arguments; output is "" when not given.
fn parseFileArgs(command: string, args: array[string]): FileArgs | unit {
    val argc = args.size()
    if argc < 2 {
        eprintln("Error: $command requires a file argument")
        printUsage(eprintln)
        return unit
    }
    var outputPath: string = ""
    var inputPath: string = ""
    var i = 2
    while i <= argc {
        val a = args[i]
        if a == "-o" || a == "--output" {
            i = i + 1
            if i > argc {
                eprintln("Error: $a requires an argument")
                return unit
            }
            outputPath = args[i]
        } else {
            if inputPath != "" {
                eprintln("Error: $command takes a single input file, got '$inputPath' and '$a'")
                return unit
            }
            inputPath = a
        }
        i = i + 1
    }

    if inputPath == "" {
        eprintln("Error: no input file specified")
        return unit
    }

    if hasExtension(inputPath, ".chi") == false {
        eprintln("Error: $inputPath is not a Chi source file (.chi)")
        return unit
    }

    { input: inputPath, output: outputPath }
}

// ============================================================================
// REPL mode
// ============================================================================

// ----------------------------------------------------------------------------
// Printing values
// ----------------------------------------------------------------------------

// Function values declared with `fn`, by identity, to their signature with
// parameter names.
embedLua("local replFnSignatures = setmetatable({}, { __mode = 'k' })")

// A type as the REPL prints it: Chi syntax, named records by their name.
fn replTypeText(t: Type): string {
    val tag = t.tag
    if tag == "primitive" {
        t.ids[1].name
    } else if tag == "fn" {
        val params = t.types.map { p -> replTypeText(p) }
        val ret = params.pop()
        "(${params.joinToStringWithSeparator(", ")}) -> $ret"
    } else if tag == "record" {
        if t.ids.size() > 0 {
            t.ids[1].name
        } else if t.fields.isEmpty() {
            "{}"
        } else {
            "{ ${t.fields.map { f -> "${f.name}: ${replTypeText(f.fieldType)}" }.joinToStringWithSeparator(", ")} }"
        }
    } else if tag == "sum" {
        "${replTypeText(t.lhs as Type)} | ${replTypeText(t.rhs as Type)}"
    } else if tag == "array" {
        "array[${replTypeText(t.elementType as Type)}]"
    } else if tag == "var" {
        t.name
    } else if tag == "poly" {
        replTypeText(t.body as Type)
    } else if tag == "recursive" {
        replTypeText(t.innerType as Type)
    } else {
        tag
    }
}

// Remembers the signatures of the functions a line declared with `fn`, once
// the line has run and the functions exist.
fn registerReplFns(fns: array[ReplNamedFn]) {
    for f in fns {
        var fnType = f.fnType
        while fnType.tag == "poly" {
            fnType = fnType.body as Type
        }
        val types = fnType.types
        val params: array[string] = []
        for i, name in f.paramNames {
            params.push("$name: ${replTypeText(types[i])}")
        }
        val signature = "${f.name}(${params.joinToStringWithSeparator(", ")}): ${replTypeText(types[types.size()])}"
        val name = f.name
        embedLua("local fn = package.loaded['user/default'][name]; if fn then replFnSignatures[fn] = signature end")
    }
}

fn luaTypeOf(v: any): string {
    luaExpr("type(v)") as string
}

// The variant whose constructor built `v`, from its metatable.
fn replVariantOf(v: any): string | unit {
    luaExpr("(getmetatable(v) or {}).variantName") as string | unit
}

fn replIsArray(v: any): bool {
    luaExpr("getmetatable(v) == array_meta_table or (function() local n = #v; if n == 0 then return false end; local c = 0; for _ in pairs(v) do c = c + 1 end; return c == n end)()") as bool
}

// Field names of a record value, sorted: Lua tables keep no field order.
fn replFieldNames(v: any): array[string] {
    luaExpr("(function() local ks = {}; for k in pairs(v) do if type(k) == 'string' and k:sub(1, 1) ~= '_' then ks[#ks + 1] = k end end; table.sort(ks); return ks end)()") as array[string]
}

// LuaJIT has one number type: only the static type tells 4.0 from 4.
fn replNumber(v: any, isFloat: bool): string {
    luaExpr("(v ~= v and 'NaN') or (v == 1/0 and 'Infinity') or (v == -1/0 and '-Infinity') or ((v % 1 == 0 and v >= -2^53 and v <= 2^53) and string.format(isFloat and '%d.0' or '%d', v)) or tostring(v)") as string
}

embedLua("local __RDQ = string.char(34); local __RBS = string.char(92); local __RNL = string.char(10); local __RCR = string.char(13); local __RTAB = string.char(9)")

fn replQuote(s: string): string {
    luaExpr("__RDQ .. s:gsub(__RBS, __RBS..__RBS):gsub(__RDQ, __RBS..__RDQ):gsub(__RNL, __RBS..'n'):gsub(__RCR, __RBS..'r'):gsub(__RTAB, __RBS..'t') .. __RDQ") as string
}

fn replPrimitiveName(t: Type): string {
    if t.tag == "primitive" { t.ids[1].name } else { "" }
}

// Whether `v` can be a value of the sum member `t`.
fn replFits(v: any, t: Type): bool {
    val kind = luaTypeOf(v)
    val tag = t.tag
    if tag == "poly" {
        replFits(v, t.body as Type)
    } else if tag == "recursive" {
        replFits(v, t.innerType as Type)
    } else if tag == "var" {
        true
    } else if tag == "primitive" {
        val name = replPrimitiveName(t)
        when {
            name == "any" -> true
            name == "int" -> v is int
            name == "float" -> kind == "number"
            name == "bool" -> kind == "boolean"
            name == "string" -> kind == "string"
            name == "unit" -> kind == "nil"
            else -> false
        }
    } else if tag == "fn" {
        kind == "function"
    } else if tag == "array" {
        kind == "table" && replIsArray(v)
    } else if tag == "record" {
        kind == "table" && replVariantOf(v) == (if t.name != "" { t.name } else { unit })
    } else {
        false
    }
}

// The type that describes `v`: `t` without poly and recursive wrappers and
// narrowed to the fitting sum member. Unit when the static type does not
// say (`any`, a type variable, no member fits).
fn replTypeOf(v: any, t: Type | unit): Type | unit {
    if t == unit {
        return unit
    }
    val ty = t as Type
    val tag = ty.tag
    if tag == "poly" {
        replTypeOf(v, ty.body)
    } else if tag == "recursive" {
        replTypeOf(v, ty.innerType)
    } else if tag == "var" || replPrimitiveName(ty) == "any" {
        unit
    } else if tag == "sum" {
        val members = ty.sumListTypes()
        val index = members.indexOf { m -> replFits(v, m as Type) }
        if index == unit { unit } else { replTypeOf(v, members[index as int] as Type) }
    } else {
        ty
    }
}

// How the REPL prints a value. `t` is its static type; where that does not
// say what the value is, the runtime value decides. `seen` holds the tables
// being printed, to cut cycles.
fn replShow(v: any, t: Type | unit, seen: any): string {
    val ty = replTypeOf(v, t)
    val tag = if ty != unit { (ty as Type).tag } else { "" }
    val kind = luaTypeOf(v)
    if kind == "number" {
        replNumber(v, ty != unit && replPrimitiveName(ty as Type) == "float")
    } else if kind == "string" {
        replQuote(v as string)
    } else if kind == "function" {
        val signature: any = luaExpr("replFnSignatures[v]")
        if signature != unit {
            "<function $signature>"
        } else if tag == "fn" {
            "<function ${replTypeText(ty as Type)}>"
        } else {
            "<function>"
        }
    } else if kind == "nil" {
        "unit"
    } else if kind != "table" {
        luaExpr("tostring(v)") as string
    } else if luaExpr("seen[v]") as bool {
        "<circular>"
    } else {
        embedLua("seen[v] = true")
        val variant = replVariantOf(v)
        var result = ""
        if tag == "array" || (tag != "record" && variant == unit && replIsArray(v)) {
            val elementType = if tag == "array" { (ty as Type).elementType } else { unit }
            val items: array[string] = []
            val n = luaExpr("#v") as int
            var i = 1
            while i <= n {
                items.push(replShow(luaExpr("v[i]"), elementType, seen))
                i = i + 1
            }
            result = "[${items.joinToStringWithSeparator(", ")}]"
        } else {
            // Declared fields in declaration order, then any others the value has.
            val declared: array[{ name: string, fieldType: Type }] = if tag == "record" { (ty as Type).fields } else { [] }
            val parts: array[string] = []
            for f in declared {
                val name = f.name
                parts.push("$name: ${replShow(luaExpr("v[name]"), f.fieldType, seen)}")
            }
            for name in replFieldNames(v) {
                if declared.all { f -> f.name != name } {
                    parts.push("$name: ${replShow(luaExpr("v[name]"), unit, seen)}")
                }
            }
            val fields = parts.joinToStringWithSeparator(", ")
            result = if variant != unit {
                if parts.isEmpty() { variant as string } else { "$variant($fields)" }
            } else if parts.isEmpty() {
                "{}"
            } else {
                "{ $fields }"
            }
        }
        embedLua("seen[v] = nil")
        result
    }
}

pub fn runRepl(): int {
    if loadStdlib() == false {
        return 1
    }
    val ns = newReplCompilationEnv()

    embedLua("io.write('> '); io.flush()")
    var line: any = luaExpr("io.read('*l')")
    while line != unit {
        val lineStr = line as string
        val isEmpty = luaExpr("lineStr:find('%S') == nil") as bool
        if isEmpty == false {
            val result = compileReplLine(lineStr, ns)
            val luaCode: any = luaExpr("result.luaCode")
            val messages: any = luaExpr("result.messages")
            val msgCount = luaExpr("#messages") as int
            if luaCode == unit {
                var i = 1
                while i <= msgCount {
                    val msg: any = luaExpr("messages[i]")
                    val formatted = formatMessage(msg)
                    eprintln("Error: $formatted")
                    i = i + 1
                }
            } else {
                embedLua("__repl_chunk, __repl_err = load(luaCode, 'repl')")
                val loadErr: any = luaExpr("__repl_err")
                if loadErr != unit {
                    val errStr = luaExpr("tostring(__repl_err)") as string
                    eprintln("Error: $errStr")
                } else {
                    val saved = saveReplMetadata()
                    embedLua("__repl_ok, __repl_val = pcall(__repl_chunk)")
                    val runOk = luaExpr("__repl_ok") as bool
                    if runOk == false {
                        restoreReplMetadata(saved)
                        val errStr = luaExpr("tostring(__repl_val)") as string
                        eprintln("Runtime error: $errStr")
                    } else {
                        commitReplLine(ns, result)
                        registerReplFns(result.namedFns)
                        val value: any = luaExpr("__repl_val")
                        if result.shouldPrint && value != unit {
                            println(replShow(value, result.valueType, luaExpr("{}")))
                        }
                    }
                }
            }
        }
        embedLua("io.write('> '); io.flush()")
        line = luaExpr("io.read('*l')")
    }
    println("")
    0
}

// ============================================================================
// Main entry point
// ============================================================================

pub fn cliMain(args: any): int {
    val argc = luaExpr("args and #args or 0") as int

    if argc == 0 {
        return runRepl()
    }

    // Parse the command
    val firstArg = luaExpr("args[1]") as string

    if firstArg == "-h" {
        printUsage(println)
        return 0
    }

    if firstArg == "--help" {
        printUsage(println)
        return 0
    }

    if firstArg == "--version" {
        val isNative = luaExpr("_CHI_NATIVE == true") as bool
        if isNative {
            println("chi $CHI_VERSION (native)")
        } else {
            println("chi $CHI_VERSION")
        }
        return 0
    }

    if firstArg == "repl" {
        return runRepl()
    }

    if firstArg == "compile" {
        val parsed = parseFileArgs("compile", args as array[string])
        if parsed == unit {
            return 1
        }
        val fileArgs = parsed as FileArgs
        var outputPath = fileArgs.output
        if outputPath == "" {
            outputPath = defaultOutputPath(fileArgs.input)
        }
        if loadStdlib() == false {
            return 1
        }
        return compileFile(fileArgs.input, outputPath)
    }

    if firstArg == "build" {
        val isNative = luaExpr("_CHI_NATIVE == true") as bool
        if isNative == false {
            eprintln("Error: 'build' command requires native chi binary")
            return 1
        }
        val parsed = parseFileArgs("build", args as array[string])
        if parsed == unit {
            return 1
        }
        val fileArgs = parsed as FileArgs
        val inputPath = fileArgs.input
        var outputPath = fileArgs.output
        if outputPath == "" {
            outputPath = inputPath.byteSub(1, inputPath.byteLen() - 4)
        }
        val luaCode = compileSource(inputPath)
        if luaCode == unit {
            return 1
        }
        return luaExpr("chi_build(inputPath, luaCode, outputPath)") as int
    }

    // Default: treat first arg as a file to run
    if hasExtension(firstArg, ".chi") {
        if loadStdlib() == false {
            return 1
        }
        return runFile(firstArg)
    }

    eprintln("Error: '$firstArg' is not a .chi file")
    printUsage(eprintln)
    1
}

