package chicc/ast_converter
import std/lang { luaExpr, embedLua }
import std/lang.map { emptyMap }
import std/math { finf }
import chicc/source { Section }
import chicc/types { Type, TypeId, RecordField, tAny, tUnit, tBool, tInt, tFloat, tString, variableType, functionType, recordType, sumType, newTypeId, variantNameOf, sumListTypes }
import chicc/ast { Expr, Target, FnParam, HandleCase, ExprField, localTarget, packageTarget, setExprType, atomExpr, interpolatedStringExpr, createRecordExpr, createVariantExpr, createArrayExpr, variableAccessExpr, fieldAccessExpr, fieldAssignmentExpr, variableAssignmentExpr, declarationExpr, fnExpr, blockExpr, fnCallExpr, ifElseExpr, infixOpExpr, prefixOpExpr, castExpr_, whileLoopExpr, forLoopExpr, breakExpr, continueExpr, indexOpExpr, indexedAssignmentExpr, isExpr, effectDefinitionExpr, handleExpr, returnExpr, newHandleCase, newExprField, newFnParam }
import chicc/parse_ast { ParseAst, paArguments, paArrayValues, paBody, paBoolValue, paCallee, paCondition, paEffectCases, paElseBody, paElseCase, paFloatValue, paForBody, paForInit, paForState, paForVars, paFormalArguments, paFuncBody, paHandleBody, paIndexExpr, paIndexValue, paInterpValue, paIsMutable, paIsPublic, paIterable, paLeft, paLongValue, paLoopBody, paMemberName, paMemberSection, paName, paOp, paOpTemplate, paParts, paReceiver, paReceiverName, paRecordFields, paReturnTypeRef, paReturnValue, paRight, paSection, paStringValue, paSymbolName, paTag, paThenBody, paTypeParameters, paTypeRef, paValue, paVariable, paVariableName, paWhenCases }
import chicc/symbols { FnSymbolTable, Symbol, newFnSymbolTable, fstAddLocal, fstAddArgument, fstGet, fstRemove, newSymbol, ctGetLocalSymbol, ctDefineSymbol, ctRemoveSymbol, ctGetAliasedPackage, lookupLoadedPublicSymbol, CompileTables, TypeTable, resolveType }

// --- State (module-level mutable variables) ---

var currentFnSymbolTable: any = unit
var currentTypeSchemeVars: array[string] = []
var typeSchemeLevel: any = unit
var currentTypeLevel: int = 0
var nextTempVarId: int = 0
var weaveInput: any = unit

// --- Helpers ---

fn effectiveTypeLevel(): int {
    if typeSchemeLevel != unit {
        typeSchemeLevel as int
    } else {
        currentTypeLevel
    }
}

fn nextTempVarName(): string {
    val id = nextTempVarId
    nextTempVarId = id + 1
    "tempVar$id"
}

fn getTypeTable(tables: any): any {
    luaExpr("tables.localTypeTable")
}

fn formatSignificant(v: float, digits: int): string {
    luaExpr("string.format('%.' .. digits .. 'g', v)") as string
}

// Lua text that reads back as exactly `v`. A source literal is never negative
// or NaN, and one beyond double range arrives here as infinity.
fn floatLiteral(v: float): string {
    if v == finf { return "(1/0)" }
    var digits = 15
    var s = formatSignificant(v, digits)
    while s.toFloat() != v {
        digits = digits + 1
        s = formatSignificant(v, digits)
    }
    if s.contains(".") || s.contains("e") { s } else { "$s.0" }
}

// --- Symbol management ---

pub fn getSymbol(name: string, tables: any): Target {
    val fst: any = currentFnSymbolTable
    if fst != unit {
        val fnSym: any = fstGet(fst as FnSymbolTable, name)
        if fnSym != unit {
            return localTarget(name)
        }
    }
    val ctSym: any = ctGetLocalSymbol(tables as CompileTables, name)
    if ctSym != unit {
        val symMod = luaExpr("ctSym.moduleName") as string
        val symPkg = luaExpr("ctSym.packageName") as string
        val symName = luaExpr("ctSym.name") as string
        return packageTarget(symMod, symPkg, symName)
    }
    // Fallback: search all loaded packages for a public symbol (JVM-style
    // import-free resolution of public declarations).
    val loadedSym: any = lookupLoadedPublicSymbol(name)
    if loadedSym != unit {
        val loadedMod = luaExpr("loadedSym.moduleName") as string
        val loadedPkg = luaExpr("loadedSym.packageName") as string
        return packageTarget(loadedMod, loadedPkg, name)
    }
    // Not found: return local target
    localTarget(name)
}

// Whether the local binding getSymbol resolves `name` to here is mutable;
// false when `name` resolves to no local.
fn isMutableLocal(name: string): bool {
    val fst: any = currentFnSymbolTable
    if fst == unit { return false }
    val sym: any = fstGet(fst as FnSymbolTable, name)
    sym != unit && (sym.isMutable as bool)
}

// Returns the target that getSymbol resolves the name to from here on.
pub fn addLocalSymbol(name: string, isMut: bool, isPub: bool, symType: any, pkg: any, tables: any): Target {
    val fst: any = currentFnSymbolTable
    if fst != unit {
        fstAddLocal(fst as FnSymbolTable, name, unit, isMut)
        localTarget(name)
    } else {
        val mod: string = luaExpr("pkg.moduleName")
        val pkgName: string = luaExpr("pkg.packageName")
        val sym = newSymbol(mod, pkgName, name, symType, isPub, isMut)
        ctDefineSymbol(tables as CompileTables, sym)
        packageTarget(mod, pkgName, name)
    }
}

pub fn removeLocalSymbol(name: string, tables: any) {
    val fst: any = currentFnSymbolTable
    if fst != unit {
        fstRemove(fst as FnSymbolTable, name)
    } else {
        ctRemoveSymbol(tables as CompileTables, name)
    }
}

// --- Forward declarations for mutually-recursive convert helpers ---

// Initializers are placeholder stubs; each is reassigned to its *Impl below
// before any call. They return a real Expr (not unit) so the narrowed
// (any, any, any) -> Expr type holds without relying on unit/record unification.
var convertLambda: (any, any, any) -> Expr = { node, pkg, tables -> atomExpr("unit", tUnit, unit) }
var convertFuncWithName: (any, any, any) -> Expr = { node, pkg, tables -> atomExpr("unit", tUnit, unit) }
var convertFnCall: (any, any, any) -> Expr = { node, pkg, tables -> atomExpr("unit", tUnit, unit) }
var convertNameDeclaration: (any, any, any) -> Expr = { node, pkg, tables -> atomExpr("unit", tUnit, unit) }
var convertBlock: (any, any, any) -> Expr = { node, pkg, tables -> atomExpr("unit", tUnit, unit) }
var convertFor: (any, any, any) -> Expr = { node, pkg, tables -> atomExpr("unit", tUnit, unit) }
var convertWhen: (any, any, any) -> Expr = { node, pkg, tables -> atomExpr("unit", tUnit, unit) }
var convertFieldAccess: (any, any, any) -> Expr = { node, pkg, tables -> atomExpr("unit", tUnit, unit) }
var convertHandle: (any, any, any) -> Expr = { node, pkg, tables -> atomExpr("unit", tUnit, unit) }
var convertWeave: (any, any, any) -> Expr = { node, pkg, tables -> atomExpr("unit", tUnit, unit) }

// --- Effect definition conversion (no mutual recursion with convert) ---

fn convertEffectDefinition(node: any, pkg: any, tables: any): Expr {
    val sec = node.paSection()
    val isPub = node.paIsPublic()
    val effName = node.paName()
    val typeParams = node.paTypeParameters()
    val args = node.paFormalArguments()
    val retTypeRef: any = node.paReturnTypeRef()

    // Save and set type scheme
    val prevTypeSchemeVars = currentTypeSchemeVars
    val prevTypeSchemeLevel = typeSchemeLevel

    var tpNames: array[string] = []
    var tpIdx = 1
    val tpCount = typeParams.size()
    while tpIdx <= tpCount {
        val tp = typeParams[tpIdx]
        val tpName = luaExpr("tp.name") as string
        tpNames.push(tpName)
        tpIdx = tpIdx + 1
    }
    currentTypeSchemeVars = tpNames
    typeSchemeLevel = currentTypeLevel

    val tt = getTypeTable(tables)

    var params: array[any] = []
    var typeArr: array[any] = []
    var i = 1
    val argCount = args.size()
    while i <= argCount {
        val arg = args[i]
        val argName = luaExpr("arg.name") as string
        val argTypeRef = luaExpr("arg.typeRef") as any
        val argSec = luaExpr("arg.section") as any

        var argType: any = tAny
        if argTypeRef != unit {
            argType = resolveType(tt, currentTypeSchemeVars, argTypeRef, effectiveTypeLevel())
        }
        params.push(newFnParam(argName, argType as Type | unit, argSec as Section | unit) as any)
        typeArr.push(argType)
        i = i + 1
    }

    // Add return type
    var retType: any = tUnit
    if retTypeRef != unit {
        retType = resolveType(tt, currentTypeSchemeVars, retTypeRef, effectiveTypeLevel())
    }
    typeArr.push(retType)

    val effType = functionType(typeArr as array[Type], tpNames, 0)

    // Restore type scheme
    currentTypeSchemeVars = prevTypeSchemeVars
    typeSchemeLevel = prevTypeSchemeLevel

    val modName = luaExpr("pkg.moduleName") as string
    val pkgName = luaExpr("pkg.packageName") as string

    val result: any = effectDefinitionExpr(modName, pkgName, effName, params as array[FnParam], sec as Section | unit)
    setExprType(result as Expr, effType as Type | unit)

    // Register effect as a local symbol
    addLocalSymbol(effName, false, isPub, effType, pkg, tables)

    result
}

// --- Main converter ---

pub fn convert(node: any, pkg: any, tables: any): Expr {
    val tag = node.paTag()
    val sec = node.paSection()

    if tag == "UnitValue" {
        atomExpr("unit", tUnit, sec)
    } else if tag == "LongValue" {
        val v = node.paLongValue()
        atomExpr("$v", tInt, sec)
    } else if tag == "FloatValue" {
        atomExpr(floatLiteral(node.paFloatValue()), tFloat, sec)
    } else if tag == "BoolValue" {
        val v = node.paBoolValue()
        if v { atomExpr("true", tBool, sec) }
        else { atomExpr("false", tBool, sec) }
    } else if tag == "StringValue" {
        val v = node.paStringValue()
        atomExpr(v, tString, sec)
    } else if tag == "StringText" {
        val v = node.paStringValue()
        atomExpr(v, tString, sec)
    } else if tag == "ParseInterpolation" {
        val innerVal = node.paInterpValue()
        val converted: any = convert(innerVal, pkg, tables)
        castExpr_(converted as Expr, tString, sec)
    } else if tag == "ParseInterpolatedString" {
        val parts = node.paParts()
        var convertedParts: array[any] = []
        var i = 1
        val partCount = parts.size()
        while i <= partCount {
            val part = parts[i]
            val cp: any = convert(part, pkg, tables)
            convertedParts.push(cp)
            i = i + 1
        }
        interpolatedStringExpr(convertedParts as array[Expr], sec as Section | unit)
    } else if tag == "ParseLambda" {
        convertLambda(node, pkg, tables)
    } else if tag == "ParseFuncWithName" {
        convertFuncWithName(node, pkg, tables)
    } else if tag == "ParseFnCall" {
        convertFnCall(node, pkg, tables)
    } else if tag == "ParseVariableRead" {
        val varName = node.paVariableName()
        val tgt = getSymbol(varName, tables)
        variableAccessExpr(tgt, sec)
    } else if tag == "ParseAssignment" {
        val varName = node.paVariableName()
        val tgt = getSymbol(varName, tables)
        val isMut = isMutableLocal(varName)
        val val_ = convert(node.paValue(), pkg, tables)
        variableAssignmentExpr(tgt, isMut, val_, sec)
    } else if tag == "ParseIndexOperator" {
        val var_ = convert(node.paVariable(), pkg, tables)
        val idx = convert(node.paIndexExpr(), pkg, tables)
        indexOpExpr(var_, idx, sec)
    } else if tag == "ParseIndexedAssignment" {
        val var_ = convert(node.paVariable(), pkg, tables)
        val idx = convert(node.paIndexExpr(), pkg, tables)
        val val_ = convert(node.paIndexValue(), pkg, tables)
        indexedAssignmentExpr(var_, idx, val_, sec)
    } else if tag == "ParseNameDeclaration" {
        convertNameDeclaration(node, pkg, tables)
    } else if tag == "ParseBlock" {
        convertBlock(node, pkg, tables)
    } else if tag == "ParseGroup" {
        convert(node.paValue(), pkg, tables)
    } else if tag == "ParseIfElse" {
        val cond = convert(node.paCondition(), pkg, tables)
        val thenB = convert(node.paThenBody(), pkg, tables)
        val elseNode: any = node.paElseBody()
        val elseB: any = if elseNode != unit { convert(elseNode, pkg, tables) } else { unit }
        ifElseExpr(cond as Expr, thenB as Expr, elseB as Expr | unit, sec as Section | unit)
    } else if tag == "ParseWhile" {
        val cond = convert(node.paCondition(), pkg, tables)
        val loopBody = convert(node.paLoopBody(), pkg, tables)
        whileLoopExpr(cond, loopBody, sec)
    } else if tag == "ParseFor" {
        convertFor(node, pkg, tables)
    } else if tag == "ParseWhen" {
        convertWhen(node, pkg, tables)
    } else if tag == "ParseReturn" {
        val retVal: any = node.paReturnValue()
        val converted: any = if retVal != unit { convert(retVal, pkg, tables) } else { atomExpr("unit", tUnit, sec) }
        returnExpr(converted as Expr, sec as Section | unit)
    } else if tag == "ParseBreak" {
        breakExpr(sec)
    } else if tag == "ParseContinue" {
        continueExpr(sec)
    } else if tag == "ParseNot" {
        val inner = convert(node.paValue(), pkg, tables)
        prefixOpExpr("!", inner, sec)
    } else if tag == "ParseBinaryOp" {
        val op = node.paOp()
        val left = convert(node.paLeft(), pkg, tables)
        val right = convert(node.paRight(), pkg, tables)
        infixOpExpr(op, left, right, sec)
    } else if tag == "ParseCast" {
        val inner = convert(node.paValue(), pkg, tables)
        val tt = getTypeTable(tables)
        val targetType = resolveType(tt, currentTypeSchemeVars, node.paTypeRef(), effectiveTypeLevel())
        castExpr_(inner, targetType, sec)
    } else if tag == "ParseIs" {
        val inner = convert(node.paValue(), pkg, tables)
        val tt = getTypeTable(tables)
        val checkedType = resolveType(tt, currentTypeSchemeVars, node.paTypeRef(), effectiveTypeLevel())
        isExpr(inner, checkedType, sec)
    } else if tag == "ParseFieldAccess" {
        convertFieldAccess(node, pkg, tables)
    } else if tag == "ParseFieldAssignment" {
        val recv = convert(node.paReceiver(), pkg, tables)
        val memName = node.paMemberName()
        val val_ = convert(node.paValue(), pkg, tables)
        fieldAssignmentExpr(recv, memName, val_, sec)
    } else if tag == "ParseCreateArray" {
        val values = node.paArrayValues()
        var converted: array[any] = []
        var i = 1
        val count = values.size()
        while i <= count {
            val cv: any = convert(values[i], pkg, tables)
            converted.push(cv)
            i = i + 1
        }
        createArrayExpr(converted as array[Expr], sec as Section | unit)
    } else if tag == "ParseCreateRecord" {
        val fields = node.paRecordFields()
        var converted: array[any] = []
        var i = 1
        val count = fields.size()
        while i <= count {
            val f = fields[i]
            val fName = luaExpr("f.name") as string
            val fValue = luaExpr("f.value") as any
            val cv: any = convert(fValue, pkg, tables)
            converted.push(newExprField(fName, cv as Expr))
            i = i + 1
        }
        createRecordExpr(converted as array[ExprField], sec as Section | unit)
    } else if tag == "ParseEffectDefinition" {
        convertEffectDefinition(node, pkg, tables)
    } else if tag == "ParseHandle" {
        convertHandle(node, pkg, tables)
    } else if tag == "ParseWeave" {
        convertWeave(node, pkg, tables)
    } else if tag == "ParseWeavePlaceholder" {
        if weaveInput != unit {
            weaveInput
        } else {
            atomExpr("unit", tUnit, sec)
        }
    } else {
        // Unknown tag, return unit atom
        println("WARNING: ast_converter unknown tag '$tag'")
        atomExpr("unit", tUnit, sec)
    }
}

// --- Lambda conversion ---

fn convertLambdaImpl(node: any, pkg: any, tables: any): Expr {
    val sec = node.paSection()
    val args = node.paFormalArguments()
    val bodyNodes = node.paBody()

    val parentFst: any = currentFnSymbolTable
    val fst = newFnSymbolTable(parentFst)
    val prevFst = currentFnSymbolTable
    currentFnSymbolTable = fst

    var params: array[any] = []
    val defaultArgs = emptyMap[string, any]()
    var defaultArgCount = 0
    var fnTypes: array[any] = []
    var i = 1
    val argCount = args.size()
    while i <= argCount {
        val arg = args[i]
        val argName = luaExpr("arg.name") as string
        val argTypeRef = luaExpr("arg.typeRef") as any
        val argDefValue = luaExpr("arg.defaultValue") as any
        val argSec = luaExpr("arg.section") as any

        var argType: any = unit
        if argTypeRef != unit {
            val tt = getTypeTable(tables)
            argType = resolveType(tt, currentTypeSchemeVars, argTypeRef, effectiveTypeLevel())
        }

        if argDefValue != unit {
            val defExpr: any = convert(argDefValue, pkg, tables)
            defaultArgs.put(argName, defExpr)
            defaultArgCount = defaultArgCount + 1
        }

        fstAddArgument(fst, argName, argType)
        params.push(newFnParam(argName, argType as Type | unit, argSec as Section | unit) as any)

        // Build type array for function type
        if argType != unit {
            fnTypes.push(argType)
        } else {
            val varType = variableType("_p$i", 1)
            fnTypes.push(varType)
        }

        i = i + 1
    }

    // Add return type variable
    val retVar = variableType("_ret", 1)
    fnTypes.push(retVar)

    // Convert body
    var bodyExprs: array[any] = []
    i = 1
    val bodyCount = bodyNodes.size()
    while i <= bodyCount {
        val be: any = convert(bodyNodes[i], pkg, tables)
        bodyExprs.push(be)
        i = i + 1
    }

    currentFnSymbolTable = prevFst

    val body = blockExpr(bodyExprs as array[Expr], sec as Section | unit)

    val funcType = functionType(fnTypes as array[Type], [] as array[string], defaultArgCount)

    val defaults: any = if defaultArgCount > 0 { defaultArgs } else { unit }
    val result: any = fnExpr(params as array[FnParam], defaults, body as Expr, sec as Section | unit)
    setExprType(result as Expr, funcType as Type | unit)
    result
}

convertLambda = convertLambdaImpl

// --- FuncWithName conversion ---

fn convertFuncWithNameImpl(node: any, pkg: any, tables: any): Expr {
    val sec = node.paSection()
    val fnName = node.paName()
    val isPub = node.paIsPublic()
    val typeParams = node.paTypeParameters()
    val args = node.paFormalArguments()
    val retTypeRef: any = node.paReturnTypeRef()
    val funcBodyNode: any = node.paFuncBody()

    // Save and set type scheme variables
    val prevTypeSchemeVars = currentTypeSchemeVars
    val prevTypeSchemeLevel = typeSchemeLevel

    var tpNames: array[string] = []
    var tpIdx = 1
    val tpCount = typeParams.size()
    while tpIdx <= tpCount {
        val tp = typeParams[tpIdx]
        val tpName = luaExpr("tp.name") as string
        tpNames.push(tpName)
        tpIdx = tpIdx + 1
    }
    currentTypeSchemeVars = tpNames
    typeSchemeLevel = currentTypeLevel + 1

    val tt = getTypeTable(tables)

    // Compute function type from annotations BEFORE converting body
    var paramTypes: array[any] = []
    var defaultArgCount = 0
    var i = 1
    val argCount = args.size()
    while i <= argCount {
        val arg = args[i]
        val argTypeRef = luaExpr("arg.typeRef") as any
        val argDefValue = luaExpr("arg.defaultValue") as any
        if argTypeRef != unit {
            val resolved = resolveType(tt, currentTypeSchemeVars, argTypeRef, effectiveTypeLevel())
            paramTypes.push(resolved)
        } else {
            paramTypes.push(variableType("_p$i", effectiveTypeLevel()))
        }
        if argDefValue != unit {
            defaultArgCount = defaultArgCount + 1
        }
        i = i + 1
    }

    // Resolve return type
    var returnType: any = tUnit
    if retTypeRef != unit {
        returnType = resolveType(tt, currentTypeSchemeVars, retTypeRef, effectiveTypeLevel())
    }

    // Build function type: [paramTypes..., returnType]
    var fnTypeArr: array[any] = []
    i = 1
    val ptCount = paramTypes.size()
    while i <= ptCount {
        fnTypeArr.push(paramTypes[i])
        i = i + 1
    }
    fnTypeArr.push(returnType)
    val funcType = functionType(fnTypeArr as array[Type], tpNames, defaultArgCount)

    // Register symbol BEFORE converting body (for self-recursion)
    val fnTarget = addLocalSymbol(fnName, false, isPub, funcType, pkg, tables)

    // Create FnSymbolTable for the function
    val parentFst = currentFnSymbolTable
    val fst = newFnSymbolTable(parentFst)
    val prevFst = currentFnSymbolTable
    currentFnSymbolTable = fst

    // Add arguments to the fn symbol table and build params
    var params: array[any] = []
    val defaultArgs = emptyMap[string, any]()
    i = 1
    while i <= argCount {
        val arg = args[i]
        val argName = luaExpr("arg.name") as string
        val argTypeRef = luaExpr("arg.typeRef") as any
        val argDefValue = luaExpr("arg.defaultValue") as any
        val argSec = luaExpr("arg.section") as any

        var argType: any = unit
        if argTypeRef != unit {
            argType = resolveType(tt, currentTypeSchemeVars, argTypeRef, effectiveTypeLevel())
        }

        if argDefValue != unit {
            val defExpr: any = convert(argDefValue, pkg, tables)
            defaultArgs.put(argName, defExpr)
        }

        fstAddArgument(fst, argName, argType)
        params.push(newFnParam(argName, argType as Type | unit, argSec as Section | unit) as any)
        i = i + 1
    }

    // Convert body with incremented type level
    currentTypeLevel = currentTypeLevel + 1
    val body: any = convert(funcBodyNode, pkg, tables)
    currentTypeLevel = currentTypeLevel - 1

    // If the return type is a function type and the body ends with a block,
    // convert that trailing block to a zero-arg lambda.
    // In Chi, { ... } without -> in expression position is a zero-arg lambda
    // when the context expects a function type (e.g. fn foo(): () -> int { { 42 } })
    val retTag = luaExpr("returnType.tag") as string
    if retTag == "fn" {
        val bodyKind = luaExpr("body.kind") as string
        if bodyKind == "block" {
            val bodyCount = luaExpr("#body.blockBody") as int
            if bodyCount > 0 {
                val lastExpr = luaExpr("body.blockBody[bodyCount]") as any
                val lastKind = luaExpr("lastExpr.kind") as string
                if lastKind == "block" {
                    val lambdaRetVar = variableType("_ret", effectiveTypeLevel())
                    val lambdaType = functionType([lambdaRetVar] as array[Type], [] as array[string], 0)
                    val lambdaParams: array[FnParam] = []
                    val lambdaSec = luaExpr("lastExpr.section") as any
                    val lambdaFn: any = fnExpr(lambdaParams, unit, lastExpr as Expr, lambdaSec as Section | unit)
                    setExprType(lambdaFn as Expr, lambdaType as Type | unit)
                    embedLua("body.blockBody[bodyCount] = lambdaFn")
                }
            }
        }
    }

    currentFnSymbolTable = prevFst

    // Restore type scheme state
    currentTypeSchemeVars = prevTypeSchemeVars
    typeSchemeLevel = prevTypeSchemeLevel

    val defaults: any = if defaultArgCount > 0 { defaultArgs } else { unit }
    val fnBody = fnExpr(params as array[FnParam], defaults, body as Expr, sec as Section | unit)

    val decl = declarationExpr(isPub, fnTarget, false, funcType as Type | unit, fnBody as Expr, sec as Section | unit)
    decl.isNamedFn = true
    decl
}

convertFuncWithName = convertFuncWithNameImpl

// --- FnCall conversion ---

// The package-level symbol `name` resolves to; unit when a function-scope
// local shadows it.
fn packageSymbol(name: string, tables: any): Symbol | unit {
    val fst: any = currentFnSymbolTable
    if fst != unit && fstGet(fst as FnSymbolTable, name) != unit {
        return unit
    }
    ctGetLocalSymbol(tables as CompileTables, name)
}

// Is `name` a package-level nullary variant value (see lowerVariantTypes)?
fn isNullaryVariant(name: string, tables: any): bool {
    val sym = packageSymbol(name, tables)
    if sym == unit { return false }
    val symType: any = (sym as Symbol).symbolType
    symType != unit && (symType as Type).sumListTypes().any { t -> variantNameOf(t as Type) == name && (t as Type).fields.size() == 0 }
}

fn convertFnCallImpl(node: any, pkg: any, tables: any): Expr {
    val sec = node.paSection()
    val calleeNode: any = node.paCallee()
    val argNodes = node.paArguments()

    // `N()` on a nullary variant is the variant value itself.
    if argNodes.size() == 0 && calleeNode.paTag() == "ParseVariableRead" && isNullaryVariant(calleeNode.paVariableName(), tables) {
        return convert(calleeNode, pkg, tables)
    }

    val callee: any = convert(calleeNode, pkg, tables)

    var convertedArgs: array[any] = []
    var i = 1
    val argCount = argNodes.size()
    while i <= argCount {
        val ca: any = convert(argNodes[i], pkg, tables)
        convertedArgs.push(ca)
        i = i + 1
    }

    val calleeTag = calleeNode.paTag()

    // Wrap block arguments in zero-arg lambdas
    // When a block { ... } is passed as a function argument, it should be treated
    // as a zero-arg lambda { -> ... } (thunk), not as a bare block expression.
    var wi = 1
    val wCount = convertedArgs.size()
    while wi <= wCount {
        val arg: any = convertedArgs[wi]
        val argKind = luaExpr("arg.kind") as string
        if argKind == "block" {
            val emptyParams: array[FnParam] = []
            val blockSec: any = luaExpr("arg.section") as any
            val wrappedFn = fnExpr(emptyParams, unit, arg as Expr, blockSec as Section | unit)
            embedLua("convertedArgs[wi] = wrappedFn")
        }
        wi = wi + 1
    }

    // Wrap block callee in zero-arg lambda (IIFE pattern: { ... }())
    // When a block is immediately invoked with no arguments, treat it as a thunk.
    var wrappedCallee: any = callee
    if calleeTag == "ParseBlock" {
        if argCount == 0 {
            val calleeKind = luaExpr("callee.kind") as string
            if calleeKind == "block" {
                val emptyParams: array[FnParam] = []
                val calleeSec: any = luaExpr("callee.section") as any
                wrappedCallee = fnExpr(emptyParams, unit, callee as Expr, calleeSec as Section | unit)
            }
        }
    }

    fnCallExpr(wrappedCallee as Expr, convertedArgs as array[Expr], sec as Section | unit)
}

convertFnCall = convertFnCallImpl

// --- Block conversion ---

// A block is a scope, also at top level: its names become locals that are
// not visible after it.
fn convertBlockImpl(node: any, pkg: any, tables: any): Expr {
    val sec = node.paSection()
    val bodyNodes = node.paBody()

    val prevFst = currentFnSymbolTable
    currentFnSymbolTable = newFnSymbolTable(prevFst)
    currentTypeLevel = currentTypeLevel + 1
    var bodyExprs: array[any] = []
    var i = 1
    val count = bodyNodes.size()
    while i <= count {
        val be: any = convert(bodyNodes[i], pkg, tables)
        bodyExprs.push(be)
        i = i + 1
    }
    currentTypeLevel = currentTypeLevel - 1
    currentFnSymbolTable = prevFst

    blockExpr(bodyExprs as array[Expr], sec as Section | unit)
}

convertBlock = convertBlockImpl

// --- NameDeclaration conversion ---

fn convertNameDeclarationImpl(node: any, pkg: any, tables: any): Expr {
    val sec = node.paSection()
    val isPub = node.paIsPublic()
    val symName = node.paSymbolName()
    val isMut = node.paIsMutable()
    val typeRef: any = node.paTypeRef()
    val valNode: any = node.paValue()

    val val_ = convert(valNode, pkg, tables)

    currentTypeLevel = currentTypeLevel + 1

    var expType: any = unit
    if typeRef != unit {
        val tt = getTypeTable(tables)
        expType = resolveType(tt, currentTypeSchemeVars, typeRef, effectiveTypeLevel())
    }

    // Register the symbol
    var symType: any = unit
    // If the value is a function, try to use the function type
    val valKind = luaExpr("val_.kind") as string
    if valKind == "fn" {
        symType = luaExpr("val_.exprType") as any
    }
    val symTarget = addLocalSymbol(symName, isMut, isPub, symType, pkg, tables)
    currentTypeLevel = currentTypeLevel - 1

    declarationExpr(isPub, symTarget, isMut, expType as Type | unit, val_ as Expr, sec as Section | unit)
}

convertNameDeclaration = convertNameDeclarationImpl

// --- When conversion (fold into nested IfElse) ---

// A when case body is a scope even when it is not a block.
fn convertCaseBody(node: any, pkg: any, tables: any): Expr {
    val prevFst = currentFnSymbolTable
    currentFnSymbolTable = newFnSymbolTable(prevFst)
    val body = convert(node, pkg, tables)
    currentFnSymbolTable = prevFst
    body
}

fn convertWhenImpl(node: any, pkg: any, tables: any): Expr {
    val sec = node.paSection()
    val cases = node.paWhenCases()
    val elseCase: any = node.paElseCase()

    val caseCount = cases.size()

    // Empty when
    if caseCount == 0 && elseCase == unit {
        return atomExpr("unit", tUnit, sec)
    }

    // Only else case
    if caseCount == 0 && elseCase != unit {
        val ecBody: any = luaExpr("elseCase.body")
        return convertCaseBody(ecBody, pkg, tables)
    }

    // Build from last case backward
    // Start with the last case
    val lastCase = cases[caseCount]
    val lastCond: any = luaExpr("lastCase.condition")
    val lastBody: any = luaExpr("lastCase.body")
    val lastSec: any = luaExpr("lastCase.section")

    val lastCondExpr: any = convert(lastCond, pkg, tables)
    val lastBodyExpr: any = convertCaseBody(lastBody, pkg, tables)

    var result: any = unit
    if elseCase != unit {
        val ecBody: any = luaExpr("elseCase.body")
        val elseExpr: any = convertCaseBody(ecBody, pkg, tables)
        result = ifElseExpr(lastCondExpr as Expr, lastBodyExpr as Expr, elseExpr as Expr | unit, lastSec as Section | unit) as any
    } else {
        result = ifElseExpr(lastCondExpr as Expr, lastBodyExpr as Expr, unit, lastSec as Section | unit) as any
    }

    // Fold from second-to-last to first
    var idx = caseCount - 1
    while idx >= 1 {
        val wc = cases[idx]
        val wcCond: any = luaExpr("wc.condition")
        val wcBody: any = luaExpr("wc.body")
        val wcSec: any = luaExpr("wc.section")

        val condExpr: any = convert(wcCond, pkg, tables)
        val bodyExpr: any = convertCaseBody(wcBody, pkg, tables)
        result = ifElseExpr(condExpr as Expr, bodyExpr as Expr, result as Expr | unit, wcSec as Section | unit) as any
        idx = idx - 1
    }

    result
}

convertWhen = convertWhenImpl

// --- For loop conversion ---

fn convertForImpl(node: any, pkg: any, tables: any): Expr {
    val sec = node.paSection()
    val vars = node.paForVars()
    val iterNode: any = node.paIterable()
    val stateNode: any = node.paForState()
    val initNode: any = node.paForInit()
    val bodyNode: any = node.paForBody()

    // Create a symbol table for loop variables
    val parentFst = currentFnSymbolTable
    val fst = newFnSymbolTable(parentFst)
    var vi = 1
    val varCount = vars.size()
    while vi <= varCount {
        fstAddLocal(fst, vars[vi], unit, false)
        vi = vi + 1
    }

    val iter: any = convert(iterNode, pkg, tables)
    val state: any = if stateNode != unit { convert(stateNode, pkg, tables) } else { unit }
    val init: any = if initNode != unit { convert(initNode, pkg, tables) } else { unit }

    val prevFst = currentFnSymbolTable
    currentFnSymbolTable = fst
    val body: any = convert(bodyNode, pkg, tables)
    currentFnSymbolTable = prevFst

    forLoopExpr(vars, iter as Expr, state as Expr | unit, init as Expr | unit, body as Expr, sec as Section | unit)
}

convertFor = convertForImpl

// --- FieldAccess conversion ---

fn convertFieldAccessImpl(node: any, pkg: any, tables: any): Expr {
    val sec = node.paSection()
    val receiverName = node.paReceiverName()
    val memberName = node.paMemberName()
    val memberSec = node.paMemberSection()

    // First check if the receiver is a package alias
    val aliasedPkg: any = ctGetAliasedPackage(tables as CompileTables, receiverName)
    if aliasedPkg != unit {
        val aliasMod = luaExpr("aliasedPkg.moduleName") as string
        val aliasPkg = luaExpr("aliasedPkg.packageName") as string
        // Check if the member exists as a symbol in that package
        val ns = luaExpr("tables.ns") as any
        if ns != unit {
            val pkgSym = luaExpr("ns.getSymbol and ns.getSymbol(aliasMod, aliasPkg, memberName) or nil") as any
            if pkgSym != unit {
                val sMod = luaExpr("pkgSym.moduleName") as string
                val sPkg = luaExpr("pkgSym.packageName") as string
                val recvSection = luaExpr("node.receiver and node.receiver.section or nil") as any
                return variableAccessExpr(packageTarget(sMod, sPkg, memberName), recvSection as Section | unit)
            }
        }
        // Even without ns, treat as package access
        val recvSection = luaExpr("node.receiver and node.receiver.section or nil") as any
        return variableAccessExpr(packageTarget(aliasMod, aliasPkg, memberName), recvSection as Section | unit)
    }

    // Regular field access
    val recv = convert(node.paReceiver(), pkg, tables)
    fieldAccessExpr(recv, memberName, memberSec, sec)
}

convertFieldAccess = convertFieldAccessImpl

// --- Weave conversion ---

fn convertWeaveImpl(node: any, pkg: any, tables: any): Expr {
    val sec = node.paSection()
    val valNode: any = node.paValue()
    val templateNode: any = node.paOpTemplate()

    val inputValue: any = convert(valNode, pkg, tables)
    val tempVarName = nextTempVarName()

    // Create temp variable declaration
    val tempTarget = addLocalSymbol(tempVarName, false, false, unit, pkg, tables)
    val tempDecl = declarationExpr(false, tempTarget, false, unit, inputValue as Expr, valNode.paSection())

    // Create read variable for the temp var
    val readVar: any = variableAccessExpr(tempTarget, valNode.paSection())

    // Set weave input and convert template
    val prevWeaveInput = weaveInput
    weaveInput = readVar
    val filledTemplate: any = convert(templateNode, pkg, tables)
    weaveInput = prevWeaveInput

    blockExpr([tempDecl as Expr, filledTemplate as Expr], sec as Section | unit)
}

convertWeave = convertWeaveImpl

// --- Handle conversion ---

fn convertHandleImpl(node: any, pkg: any, tables: any): Expr {
    val sec = node.paSection()
    val bodyNode: any = node.paHandleBody()
    val casesArr = node.paEffectCases()

    val body: any = convert(bodyNode, pkg, tables)

    var handleCases: array[any] = []
    var i = 1
    val caseCount = casesArr.size()
    while i <= caseCount {
        val c = casesArr[i]
        val effName = luaExpr("c.effectName") as string
        val argNames = luaExpr("c.argumentNames") as array[string]
        val caseBody = luaExpr("c.body") as any
        val caseSec = luaExpr("c.section") as any

        // Create virtual symbol table for this case
        val virtualFst = newFnSymbolTable(currentFnSymbolTable)
        val prevFst = currentFnSymbolTable
        currentFnSymbolTable = virtualFst

        // Resolve effect name to get module/package info
        var eMod = ""
        var ePkg = ""
        val effTarget: any = getSymbol(effName, tables)
        val effTargetTag = luaExpr("effTarget.tag") as string
        if effTargetTag == "package" {
            eMod = luaExpr("effTarget.moduleName") as string
            ePkg = luaExpr("effTarget.packageName") as string
        }

        // Add "resume" and argument names as local symbols
        fstAddLocal(virtualFst, "resume", unit, false)
        var ai = 1
        val anCount = argNames.size()
        while ai <= anCount {
            fstAddLocal(virtualFst, argNames[ai], unit, false)
            ai = ai + 1
        }

        // Convert body
        val convertedBody: any = convert(caseBody, pkg, tables)

        // Remove symbols
        fstRemove(virtualFst, "resume")
        ai = 1
        while ai <= anCount {
            fstRemove(virtualFst, argNames[ai])
            ai = ai + 1
        }

        currentFnSymbolTable = prevFst

        handleCases.push(newHandleCase(eMod, ePkg, effName, argNames, convertedBody as Expr, caseSec as Section | unit) as any)
        i = i + 1
    }

    handleExpr(body as Expr, handleCases as array[HandleCase], sec as Section | unit)
}

convertHandle = convertHandleImpl

// --- Variant lowering ---

// Register each `data` declaration's constructor types and sum type into the
// type table, and materialise one constructor function declaration per variant
// (a named fn whose body is a createVariantExpr; a variant without fields is a
// value declaration of the data type instead). Runs in convertProgram after
// type aliases and before code, so casts/annotations resolve regardless of
// source order. Returns the constructor declarations to prepend to the program.
// Contract: registers each variant's constructor types + the data type into
// the type table, registers a symbol per variant, and returns the variant
// declarations (to prepend to the program).
// Rejects generic variants by throwing a structured error (caught by the
// pcall around it in compiler.chi).
//
// MUST run before checkNames in compile() (compiler.chi) — otherwise the
// constructor calls in user code (`Circle(2)`) fail name resolution and the
// compile bails before conversion. So it is called from compile() directly,
// not from convertProgram, and its result is prepended to the converted code.
pub fn lowerVariantTypes(parseProg: any, pkg: any, tables: any): array[Expr] {
    val variantDefs = luaExpr("parseProg.variantTypes") as array[any]
    var decls: array[any] = []
    val defCount = variantDefs.size()
    if defCount == 0 {
        return decls as array[Expr]
    }

    val tt = getTypeTable(tables)
    val modName = luaExpr("pkg.moduleName") as string
    val pkgName = luaExpr("pkg.packageName") as string
    val aliasesMap: any = luaExpr("tt.aliases")

    // Does a typeRef transitively mention any name in the `names` set? Used to
    // reject recursive variants (a field referencing the data type or a sibling
    // constructor): we register plain records/sums, which would form a cyclic
    // type the typer cannot fold (stack overflow). Recursion is out of scope.
    embedLua("__chicc_trMentions = function(tr, names) if type(tr) ~= 'table' then return false end; local t = tr.tag; if t == 'TypeNameRef' or t == 'TypeParameterRef' then return names[tr.name] == true end; if __chicc_trMentions(tr.lhs, names) or __chicc_trMentions(tr.rhs, names) or __chicc_trMentions(tr.returnType, names) or __chicc_trMentions(tr.baseType, names) then return true end; for _,a in ipairs(tr.argumentTypeRefs or {}) do if __chicc_trMentions(a, names) then return true end end; for _,a in ipairs(tr.typeParameters or {}) do if __chicc_trMentions(a, names) then return true end end; for _,f in ipairs(tr.fields or {}) do if __chicc_trMentions(f.typeRef, names) then return true end end; return false end")

    var di = 1
    while di <= defCount {
        val vdef = variantDefs[di]
        val typeName = luaExpr("vdef.typeName") as string
        val typeParams = luaExpr("vdef.typeParameters") as array[any]
        val ctors = luaExpr("vdef.constructors") as array[any]

        // Generic variants are out of scope (#14): reject cleanly rather than
        // silently degrade type parameters to `any` and miscompile.
        if typeParams.size() > 0 {
            embedLua("error({ code = 'UNSUPPORTED_FEATURE', text = 'generic data types are not supported yet (data ' .. vdef.typeName .. ')' })")
        }

        // The names this declaration introduces (the data type + every
        // constructor). A field referencing any of them is a recursive variant.
        embedLua("__chicc_vnames = {}; __chicc_vnames[vdef.typeName] = true; for _, c in ipairs(vdef.constructors) do __chicc_vnames[c.name] = true end")

        val ctorCount = ctors.size()

        // Loop 1: resolve each constructor's fields and build its nominal record
        // (marked with `name` = the variant name). No pre-registration, so no
        // cyclic type can form; recursive references are rejected up front.
        var ctorRecords: array[any] = []
        var ctorParamTypes: array[any] = []
        var ci = 1
        while ci <= ctorCount {
            val ctor = ctors[ci]
            val ctorName = luaExpr("ctor.name") as string
            val fields = luaExpr("ctor.fields") as array[any]
            val fieldCount = fields.size()

            var recFields: array[any] = []
            var paramTypes: array[any] = []
            var fi = 1
            while fi <= fieldCount {
                val field = fields[fi]
                val fieldName = luaExpr("field.name") as string
                val recursive = luaExpr("__chicc_trMentions(field.typeRef, __chicc_vnames)") as bool
                if recursive {
                    embedLua("error({ code = 'UNSUPPORTED_FEATURE', text = 'recursive data types are not supported yet (data ' .. vdef.typeName .. ')' })")
                }
                val fieldType: any = resolveType(tt, [] as array[string], luaExpr("field.typeRef"), effectiveTypeLevel())
                recFields.push(luaExpr("{ name = fieldName, fieldType = fieldType }") as any)
                paramTypes.push(fieldType)
                fi = fi + 1
            }

            val ctorId = newTypeId(modName, pkgName, ctorName)
            val rec: any = recordType([ctorId], recFields as array[RecordField], [] as array[string])
            // Mark as a variant: `name` is the discriminator variantNameOf /
            // emitIs key on (`ids` can't tell a variant from a type alias —
            // both carry ids; record `name` is "" everywhere except variants).
            embedLua("rec.name = ctorName")
            ctorRecords.push(rec)
            ctorParamTypes.push(paramTypes)
            val ctorAlias = luaExpr("{ typeId = { moduleName = modName, packageName = pkgName, name = ctorName }, aliasType = rec }") as any
            aliasesMap.put(ctorName, ctorAlias)
            ci = ci + 1
        }

        // Data type: the single record for a one-constructor `data`, else the
        // sum of all constructor records. Raw sumType, NOT sumCreate — sumCreate
        // dedups via typeEquals (which ignores ids) and would collapse two
        // structurally-identical variants into one branch.
        var dataType: any = ctorRecords[1]
        if ctorCount > 1 {
            var si = 2
            while si <= ctorCount {
                dataType = sumType([] as array[TypeId], dataType as Type, ctorRecords[si] as Type, [] as array[string])
                si = si + 1
            }
        }
        val dataAlias = luaExpr("{ typeId = { moduleName = modName, packageName = pkgName, name = typeName }, aliasType = dataType }") as any
        aliasesMap.put(typeName, dataAlias)

        // Loop 2: build a constructor function per variant: a named fn whose
        // type is (fieldTypes...) -> dataType and whose body is a tagged record.
        ci = 1
        while ci <= ctorCount {
            val ctor = ctors[ci]
            val ctorName = luaExpr("ctor.name") as string
            val ctorIsPub = luaExpr("ctor.isPublic") as bool
            val fields = luaExpr("ctor.fields") as array[any]
            val ctorSec = luaExpr("ctor.section") as any
            val paramTypes = ctorParamTypes[ci] as array[any]
            val fieldCount = fields.size()

            if fieldCount == 0 {
                val valueTarget = addLocalSymbol(ctorName, false, ctorIsPub, dataType, pkg, tables)
                val value = createVariantExpr([] as array[ExprField], ctorName, ctorSec as Section | unit)
                decls.push(declarationExpr(ctorIsPub, valueTarget, false, dataType as Type | unit, value, ctorSec as Section | unit))
                ci = ci + 1
                continue
            }

            var fnTypeArr: array[any] = []
            var fi = 1
            while fi <= fieldCount {
                fnTypeArr.push(paramTypes[fi])
                fi = fi + 1
            }
            fnTypeArr.push(dataType)
            val funcType = functionType(fnTypeArr as array[Type], [] as array[string], 0)
            val ctorTarget = addLocalSymbol(ctorName, false, ctorIsPub, funcType, pkg, tables)

            // Body: createVariantExpr binding each field to its parameter.
            // A FnSymbolTable makes the parameter reads resolve as locals.
            val parentFst = currentFnSymbolTable
            val fst = newFnSymbolTable(parentFst)
            currentFnSymbolTable = fst

            var params: array[any] = []
            var exprFields: array[any] = []
            fi = 1
            while fi <= fieldCount {
                val field = fields[fi]
                val fieldName = luaExpr("field.name") as string
                val argType = paramTypes[fi]
                fstAddArgument(fst, fieldName, argType)
                params.push(newFnParam(fieldName, argType as Type | unit, ctorSec as Section | unit) as any)
                val fieldRead = variableAccessExpr(localTarget(fieldName), ctorSec as Section | unit)
                exprFields.push(newExprField(fieldName, fieldRead as Expr) as any)
                fi = fi + 1
            }

            currentFnSymbolTable = parentFst

            val body = createVariantExpr(exprFields as array[ExprField], ctorName, ctorSec as Section | unit)
            val fnBody = fnExpr(params as array[FnParam], unit, body as Expr, ctorSec as Section | unit)
            val decl = declarationExpr(ctorIsPub, ctorTarget, false, funcType as Type | unit, fnBody as Expr, ctorSec as Section | unit)
            decls.push(decl)
            ci = ci + 1
        }

        di = di + 1
    }

    decls as array[Expr]
}

// --- Program conversion ---

pub fn convertProgram(parseProg: any, pkg: any, tables: any): array[Expr] {
    val progSection = luaExpr("parseProg.section") as any

    // Process type aliases
    val typeAliases = luaExpr("parseProg.typeAliases") as array[any]
    var i = 1
    val aliasCount = typeAliases.size()
    while i <= aliasCount {
        val alias = typeAliases[i]
        val aliasName = luaExpr("alias.name") as string
        val aliasTypeRef = luaExpr("alias.typeRef") as any
        val aliasTypeParams = luaExpr("alias.typeParameters") as array[any]

        // Resolve type params
        var tpNames: array[string] = []
        var tpi = 1
        val tpCount = aliasTypeParams.size()
        while tpi <= tpCount {
            val tp = aliasTypeParams[tpi]
            val tpName = luaExpr("tp.name") as string
            tpNames.push(tpName)
            tpi = tpi + 1
        }

        val tt = getTypeTable(tables)
        // Skip re-resolution if alias already exists in type table
        // (compiler.chi already resolved with resolveTypeAndWrapRecursive which handles recursive types)
        val aliasesMap: any = luaExpr("tt.aliases")
        val existing: any = aliasesMap.get(aliasName)
        if existing == unit {
            val resolved = resolveType(tt, tpNames, aliasTypeRef, currentTypeLevel)
            val modName = luaExpr("pkg.moduleName") as string
            val pkgName = luaExpr("pkg.packageName") as string

            // Create and register the alias
            val typeAlias = luaExpr("{ typeId = { moduleName = modName, packageName = pkgName, name = aliasName }, aliasType = resolved }") as any
            aliasesMap.put(aliasName, typeAlias)
        }

        i = i + 1
    }

    // Convert code expressions. (Variant constructor declarations are produced
    // by lowerVariantTypes, called from compile() before checkNames, and
    // prepended to this result there.)
    val codeExprs = luaExpr("parseProg.code") as array[any]
    var converted: array[any] = []
    i = 1
    val codeCount = codeExprs.size()
    while i <= codeCount {
        val ce: any = convert(codeExprs[i], pkg, tables)
        converted.push(ce)
        i = i + 1
    }

    converted as array[Expr]
}
