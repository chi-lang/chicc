// chicc/chicc/token.chi
package chicc/token
import chicc/source { Section }

// -- Literals --
pub val TK_INT = 1
pub val TK_FLOAT = 2
pub val TK_STRING = 3
pub val TK_INTERP_START = 4
pub val TK_INTERP_TEXT = 5
pub val TK_INTERP_EXPR_START = 6
pub val TK_INTERP_EXPR_END = 7
pub val TK_INTERP_END = 8

// -- Identifiers and Keywords --
pub val TK_ID = 10
pub val TK_PUB = 11
pub val TK_VAL = 12
pub val TK_VAR = 13
pub val TK_FN = 14
pub val TK_IF = 15
pub val TK_ELSE = 16
pub val TK_AS = 17
pub val TK_WHILE = 18
pub val TK_FOR = 19
pub val TK_IN = 20
pub val TK_PACKAGE = 21
pub val TK_IMPORT = 22
pub val TK_DATA = 23
pub val TK_WHEN = 24
pub val TK_MATCH = 25
pub val TK_IS = 26
pub val TK_BREAK = 27
pub val TK_CONTINUE = 28
pub val TK_EFFECT = 29
pub val TK_HANDLE = 30
pub val TK_WITH = 31
pub val TK_RETURN = 32
pub val TK_TRAIT = 33
pub val TK_TYPE = 34
pub val TK_TRUE = 35
pub val TK_FALSE = 36
pub val TK_UNIT = 37

// -- Operators --
pub val TK_PLUS = 40
pub val TK_MINUS = 41
pub val TK_STAR = 42
pub val TK_SLASH = 43
pub val TK_PERCENT = 44
pub val TK_EQ = 45
pub val TK_EQEQ = 46
pub val TK_NEQ = 47
pub val TK_LT = 48
pub val TK_LTEQ = 49
pub val TK_GT = 50
pub val TK_GTEQ = 51
pub val TK_NOT = 52
pub val TK_AND = 53
pub val TK_OR = 54
pub val TK_AMP = 55
pub val TK_PIPE = 56
pub val TK_LSHIFT = 57
pub val TK_RSHIFT = 58
pub val TK_ARROW = 59
pub val TK_WEAVE = 60
pub val TK_UNDERSCORE = 61
pub val TK_DOT = 62
pub val TK_COMMA = 63
pub val TK_COLON = 64
pub val TK_PLUSEQ = 65
pub val TK_MINUSEQ = 66
pub val TK_STAREQ = 67
pub val TK_SLASHEQ = 68

// -- Delimiters --
pub val TK_LPAREN = 70
pub val TK_RPAREN = 71
pub val TK_LBRACE = 72
pub val TK_RBRACE = 73
pub val TK_LBRACKET = 74
pub val TK_RBRACKET = 75

// -- Special --
pub val TK_EOF = 99
pub val TK_NEWLINE = 100

// Token record
type Token = {
    kind: int,
    value: string,
    section: Section | unit
}

pub fn newToken(kind: int, value: string, section: Section | unit): Token {
    { kind: kind, value: value, section: section }
}

// Keyword lookup - maps identifier strings to keyword token kinds
// Returns TK_ID if not a keyword
pub fn lookupKeyword(name: string): int {
    if name == "pub" { TK_PUB }
    else if name == "val" { TK_VAL }
    else if name == "var" { TK_VAR }
    else if name == "fn" { TK_FN }
    else if name == "if" { TK_IF }
    else if name == "else" { TK_ELSE }
    else if name == "as" { TK_AS }
    else if name == "while" { TK_WHILE }
    else if name == "for" { TK_FOR }
    else if name == "in" { TK_IN }
    else if name == "package" { TK_PACKAGE }
    else if name == "import" { TK_IMPORT }
    else if name == "data" { TK_DATA }
    else if name == "when" { TK_WHEN }
    else if name == "match" { TK_MATCH }
    else if name == "is" { TK_IS }
    else if name == "break" { TK_BREAK }
    else if name == "continue" { TK_CONTINUE }
    else if name == "effect" { TK_EFFECT }
    else if name == "handle" { TK_HANDLE }
    else if name == "with" { TK_WITH }
    else if name == "return" { TK_RETURN }
    else if name == "trait" { TK_TRAIT }
    else if name == "type" { TK_TYPE }
    else if name == "true" { TK_TRUE }
    else if name == "false" { TK_FALSE }
    else if name == "unit" { TK_UNIT }
    else { TK_ID }
}

// Display name of a token kind for diagnostics: punctuation and keywords
// quoted as written in source, other kinds named in words.
pub fn tokenKindName(kind: int): string {
    if kind == TK_INT { "integer" }
    else if kind == TK_FLOAT { "float" }
    else if kind == TK_STRING || kind == TK_INTERP_START || kind == TK_INTERP_TEXT { "string" }
    else if kind == TK_INTERP_EXPR_START { "'\${'" }
    else if kind == TK_INTERP_EXPR_END { "'}'" }
    else if kind == TK_INTERP_END { "end of string" }
    else if kind == TK_ID { "identifier" }
    else if kind == TK_PUB { "'pub'" }
    else if kind == TK_VAL { "'val'" }
    else if kind == TK_VAR { "'var'" }
    else if kind == TK_FN { "'fn'" }
    else if kind == TK_IF { "'if'" }
    else if kind == TK_ELSE { "'else'" }
    else if kind == TK_AS { "'as'" }
    else if kind == TK_WHILE { "'while'" }
    else if kind == TK_FOR { "'for'" }
    else if kind == TK_IN { "'in'" }
    else if kind == TK_PACKAGE { "'package'" }
    else if kind == TK_IMPORT { "'import'" }
    else if kind == TK_DATA { "'data'" }
    else if kind == TK_WHEN { "'when'" }
    else if kind == TK_MATCH { "'match'" }
    else if kind == TK_IS { "'is'" }
    else if kind == TK_BREAK { "'break'" }
    else if kind == TK_CONTINUE { "'continue'" }
    else if kind == TK_EFFECT { "'effect'" }
    else if kind == TK_HANDLE { "'handle'" }
    else if kind == TK_WITH { "'with'" }
    else if kind == TK_RETURN { "'return'" }
    else if kind == TK_TRAIT { "'trait'" }
    else if kind == TK_TYPE { "'type'" }
    else if kind == TK_TRUE { "'true'" }
    else if kind == TK_FALSE { "'false'" }
    else if kind == TK_UNIT { "'unit'" }
    else if kind == TK_PLUS { "'+'" }
    else if kind == TK_MINUS { "'-'" }
    else if kind == TK_STAR { "'*'" }
    else if kind == TK_SLASH { "'/'" }
    else if kind == TK_PERCENT { "'%'" }
    else if kind == TK_EQ { "'='" }
    else if kind == TK_EQEQ { "'=='" }
    else if kind == TK_NEQ { "'!='" }
    else if kind == TK_LT { "'<'" }
    else if kind == TK_LTEQ { "'<='" }
    else if kind == TK_GT { "'>'" }
    else if kind == TK_GTEQ { "'>='" }
    else if kind == TK_NOT { "'!'" }
    else if kind == TK_AND { "'&&'" }
    else if kind == TK_OR { "'||'" }
    else if kind == TK_AMP { "'&'" }
    else if kind == TK_PIPE { "'|'" }
    else if kind == TK_LSHIFT { "'<<'" }
    else if kind == TK_RSHIFT { "'>>'" }
    else if kind == TK_ARROW { "'->'" }
    else if kind == TK_WEAVE { "'~>'" }
    else if kind == TK_UNDERSCORE { "'_'" }
    else if kind == TK_DOT { "'.'" }
    else if kind == TK_COMMA { "','" }
    else if kind == TK_COLON { "':'" }
    else if kind == TK_PLUSEQ { "'+='" }
    else if kind == TK_MINUSEQ { "'-='" }
    else if kind == TK_STAREQ { "'*='" }
    else if kind == TK_SLASHEQ { "'/='" }
    else if kind == TK_LPAREN { "'('" }
    else if kind == TK_RPAREN { "')'" }
    else if kind == TK_LBRACE { "'{'" }
    else if kind == TK_RBRACE { "'}'" }
    else if kind == TK_LBRACKET { "'['" }
    else if kind == TK_RBRACKET { "']'" }
    else if kind == TK_EOF { "end of file" }
    else if kind == TK_NEWLINE { "end of line" }
    else { "unknown token" }
}

// A token found in source, for diagnostics. Only names and numbers show
// their text: a newline's text is a raw line break, and end of file and the
// end of a `$name` interpolation have empty text.
pub fn describeToken(tok: Token): string {
    val kind = tok.kind
    if kind == TK_ID || kind == TK_INT || kind == TK_FLOAT { "'${tok.value}'" }
    else { tokenKindName(kind) }
}
