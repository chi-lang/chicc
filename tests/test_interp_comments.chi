import chicc/test_util { test, assertEqual, summary }
import chicc/compiler { compileToLua, newLuaCompilationEnv, formatMessage }
import std/lang { loadLuaCode }

// Inside `${...}` whitespace and comments are skipped as outside strings and
// newlines are accepted where `( )` accepts them (#25). A `}` or `"` inside a
// comment is not an interpolation brace or a nested string.
//
// Each program is compiled by the chicc modules under test and run. eval() is
// not used: it compiles with the prebuilt chicc.lua, which would pass even if
// the sources regressed.

fn errorMessages(src: string): array[string] {
    val result = compileToLua(src, newLuaCompilationEnv())
    val errors: array[string] = []
    for m in result.messages as array[any] { errors.push(formatMessage(m)) }
    errors
}

// Returns the module's `s` value, or its compilation errors so that a failing
// assertion shows them.
fn valueOfS(src: string): any {
    val result: any = compileToLua(src, newLuaCompilationEnv())
    if result.luaCode == unit { return errorMessages(src) }
    val run = loadLuaCode(result.luaCode as string) as () -> any
    run().s
}

// ---- Comments ----

test("block comment inside interpolation") {
    assertEqual(valueOfS("val a = 1\nval s = \"v=\${a /* c */ + 1}\""), "v=2")
}

test("line comment inside interpolation continues after the operator") {
    assertEqual(valueOfS("val a = 1\nval s = \"v=\${a + // c\n 1}\""), "v=2")
}

test("line comment before the closing brace") {
    assertEqual(valueOfS("val a = 1\nval s = \"v=\${a // c\n}\""), "v=1")
}

test("brace and quote inside a comment are ignored") {
    assertEqual(valueOfS("val a = 1\nval s = \"v=\${ /* } \" */ a}\""), "v=1")
}

// ---- Newlines ----

test("newline after the opening brace") {
    assertEqual(valueOfS("val a = 1\nval s = \"v=\${\n a}\""), "v=1")
}

test("newline before the closing brace") {
    assertEqual(valueOfS("val a = 1\nval s = \"v=\${a\n}\""), "v=1")
}

// A newline before a binary operator ends the expression, as inside `( )`.
test("line comment then operator on the next line fails like in parentheses") {
    val inParens = errorMessages("val a = 1\nprintln((a // c\n + 1))")
    val inInterp = errorMessages("val a = 1\nprintln(\"v=\${a // c\n + 1}\")")
    assertEqual(inParens[1], "[SYNTAX_ERROR] Syntax error: expected ')' but got '+' (line 3, col 2)")
    assertEqual(inInterp[1], "[SYNTAX_ERROR] Syntax error: expected '}' but got '+' (line 3, col 2)")
}

summary()
