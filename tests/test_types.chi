import chicc/test_util { test, assertEqual, assertTrue, assertFalse, summary }
import chicc/types { Type, newTypeId, typeIdToString, anyTypeId, intTypeId, stringTypeId, tInt, tString, tUnit, tBool, tAny, primitiveType, functionType, recordType, sumType, arrayType, variableType, recursiveType, polyType, typeToString }
import std/lang.array { size }

test("newTypeId") {
    val id = newTypeId("std", "lang.int", "int")
    assertEqual(id.moduleName, "std")
    assertEqual(id.packageName, "lang.int")
    assertEqual(id.name, "int")
}

test("typeIdToString") {
    val id = newTypeId("std", "lang.int", "int")
    assertEqual(typeIdToString(id), "std::lang.int::int")
}

test("typeIdEquals") {
    val a = newTypeId("std", "lang.int", "int")
    val b = newTypeId("std", "lang.int", "int")
    val c = newTypeId("std", "lang.string", "string")
    assertTrue(a.typeIdEquals(b))
    assertFalse(a.typeIdEquals(c))
}

test("primitiveType") {
    assertTrue(tInt.tag == "primitive")
    assertTrue(tString.tag == "primitive")
    assertEqual(tInt.tag, "primitive")
}

test("functionType") {
    val ft = functionType([tInt, tString], [], 0)
    assertTrue(ft.tag == "fn")
    assertEqual(ft.types.size(), 2)
    assertEqual(ft.defaults, 0)
}

test("recordType") {
    val r = recordType([], [{ name: "x", fieldType: tInt }], [])
    assertTrue(r.tag == "record")
    assertEqual(r.fields.size(), 1)
}

test("sumType") {
    val s = sumType([], tInt, tString, [])
    assertTrue(s.tag == "sum")
}

test("arrayType") {
    val a = arrayType(tInt, [])
    assertTrue(a.tag == "array")
}

test("variableType") {
    val v = variableType("T", 0)
    assertTrue(v.tag == "var")
    assertEqual(v.name, "T")
}

// typeToString writes a type the way a user writes it in Chi source (#33).
test("typeToString: primitives by name") {
    assertEqual(typeToString(tInt), "int")
    assertEqual(typeToString(tString), "string")
}

test("typeToString: record lists its fields") {
    val rec = recordType([], [{ name: "a", fieldType: tInt }, { name: "b", fieldType: tString }], [])
    assertEqual(typeToString(rec), "{ a: int, b: string }")
    assertEqual(typeToString(recordType([], [], [])), "{}")
}

test("typeToString: array, function, sum and variable") {
    assertEqual(typeToString(arrayType(tInt, [])), "array[int]")
    assertEqual(typeToString(functionType([tInt, tString, tBool], [], 0)), "(int, string) -> bool")
    assertEqual(typeToString(functionType([tUnit], [], 0)), "() -> unit")
    assertEqual(typeToString(sumType([], tInt, tString, [])), "int | string")
    assertEqual(typeToString(variableType("T", 0)), "T")
}

test("typeToString: nested types") {
    val rec = recordType([], [{ name: "xs", fieldType: arrayType(tInt, []) }], [])
    assertEqual(typeToString(arrayType(rec, [])), "array[{ xs: array[int] }]")
}

test("typeToString: recursive and poly types show their inner type") {
    val v = variableType("T", 0)
    val node = recordType([], [{ name: "next", fieldType: v }], [])
    assertEqual(typeToString(recursiveType(v, node)), "{ next: T }")
    assertEqual(typeToString(polyType(0, arrayType(v, []))), "array[T]")
}

summary()
