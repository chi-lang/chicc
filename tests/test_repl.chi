import std/lang { embedLua, luaExpr }
import std/io.file { writeString, readString }
import chicc/test_util { test, assertEqual, summary }
import chicc/cli { cliMain }

// REPL sessions driven through cliMain with stdin, stdout and stderr
// redirected to temp files.

// Output lines of the session, prompts stripped and empty lines dropped.
fn sessionLines(output: string): string {
    val lines: array[string] = []
    for line in output.split("\n") {
        var l = line
        while l.startsWith("> ") {
            l = l.substring(3, l.len())
        }
        if l != "" {
            lines.push(l)
        }
    }
    lines.joinToStringWithSeparator("\n")
}

// Feeds `input` to a fresh REPL session and returns what it printed, stdout
// and stderr interleaved.
fn repl(input: string): string {
    val inPath = luaExpr("os.tmpname()") as string
    val outPath = luaExpr("os.tmpname()") as string
    writeString(inPath, input)
    // A session starts with an empty user/default package.
    embedLua("package.loaded['user/default'] = nil")
    // The REPL prints values with Lua's print and errors on io.stderr.
    embedLua("io.input(inPath); io.output(outPath); __repl_test_saved = { print = _G.print, stderr = io.stderr }; io.stderr = io.output(); _G.print = function(...) io.write(table.concat({...}, '\\t'), '\\n') end")
    val code = cliMain(["repl"])
    embedLua("io.output():close(); io.output(io.stdout); io.input(io.stdin); _G.print = __repl_test_saved.print; io.stderr = __repl_test_saved.stderr")
    val output = readString(outPath)
    embedLua("os.remove(inPath); os.remove(outPath)")
    assertEqual(code, 0)
    sessionLines(output)
}

test("a later val rebinds a name taken by an earlier import") {
    assertEqual(repl("import std/math { abs }\nval abs = 5\nabs\n"), "5")
}

test("a later fn rebinds a name taken by an earlier import") {
    assertEqual(repl("import std/lang.array { map }\nfn map(x: int): int { x + 100 }\nmap(1)\n"), "101")
}

test("a later import rebinds a name defined earlier") {
    assertEqual(repl("val abs = 5\nimport std/math { abs }\nabs(-3)\n"), "3")
}

test("a failed line keeps the earlier binding") {
    val out = repl("import std/math { abs }\nval abs: string = 5\nabs(-3)\n")
    val lines = out.split("\n")
    assertEqual(lines.size(), 2)
    assertEqual(lines[1].startsWith("Error: "), true)
    assertEqual(lines[2], "3")
}

test("a line that fails at runtime keeps the earlier bindings") {
    val out = repl("val x = 1\nval x = if [1][5] + 1 > 0 { \"a\" } else { \"b\" }\nx + 1\nval y = [1][5] + 1\ny\n")
    val lines = out.split("\n")
    assertEqual(lines.size(), 4)
    assertEqual(lines[1].startsWith("Runtime error: "), true)
    assertEqual(lines[2], "2")
    assertEqual(lines[3].startsWith("Runtime error: "), true)
    assertEqual(lines[4], "Error: [UNRECOGNIZED_NAME] Name 'y' was not recognized (line 1, col 1)")
}

test("error positions refer to the typed line") {
    val err = "Error: [UNRECOGNIZED_NAME] Name 'foo' was not recognized (line 1, col 1)"
    assertEqual(repl("foo\nimport std/math { abs }\nfoo\n"), "$err\n$err")
}

test("data constructors and type are available on later lines") {
    val out = repl("data Shape = Circle(radius: float) | Square(side: float)\nCircle(3.14)\nval s: Shape = Square(1.0)\ns is Square\ns is Circle\n")
    val lines = out.split("\n")
    assertEqual(lines.size(), 3)
    assertEqual(lines[1], "Circle(radius: 3.14)")
    assertEqual(lines[2], "true")
    assertEqual(lines[3], "false")
}

test("a type alias is available on later lines") {
    assertEqual(repl("type P = { x: int }\nval p: P = { x: 1 }\np.x\n"), "1")
}

test("the Option type is auto-imported") {
    assertEqual(repl("val o: Option[int] = 5\no\n"), "5")
}

test("a named function prints its signature with parameter names") {
    assertEqual(repl("fn greet(name: string): string { \"Hello, \$name!\" }\ngreet\n"), "<function greet(name: string): string>")
}

test("a named function keeps its name when bound to another name or nested") {
    val out = repl("fn inc(n: int): int { n + 1 }\nval f = inc\nf\n{ g: inc }\n")
    assertEqual(out, "<function inc(n: int): int>\n{ g: <function inc(n: int): int> }")
}

test("an anonymous function prints its type") {
    assertEqual(repl("{ x: int -> x * 2 }\n"), "<function (int) -> int>")
}

test("a whole float prints with a fractional part, an int without") {
    assertEqual(repl("import std/math { sqrt }\nsqrt(16.0)\n4.0\n4\n3.14\n"), "4.0\n4.0\n4\n3.14")
}

test("floats inside arrays and records print as floats") {
    assertEqual(repl("[1.0, 2.5]\n{ x: 1.0, n: 2 }\n"), "[1.0, 2.5]\n{ x: 1.0, n: 2 }")
}

test("record fields print in declaration order") {
    assertEqual(repl("val p = { name: \"Alice\", age: 30 }\np\n{ z: 1, a: { y: true, b: \"s\" } }\n"), "{ name: \"Alice\", age: 30 }\n{ z: 1, a: { y: true, b: \"s\" } }")
}

test("a variant value prints in constructor syntax") {
    val out = repl("data Shape = Circle(radius: float) | Square(side: float)\nval s: Shape = Square(1.0)\ns\n[Circle(2.0), s]\n")
    assertEqual(out, "Square(side: 1.0)\n[Circle(radius: 2.0), Square(side: 1.0)]")
}

test("a variant value of unknown static type prints in constructor syntax") {
    val out = repl("data Shape = Circle(radius: float) | Square(side: float)\nimport std/lang { luaExpr }\nluaExpr(\"package.loaded[\\\"user/default\\\"].Circle(3.14)\")\n")
    assertEqual(out, "Circle(radius: 3.14)")
}

test("an Option value prints as its underlying value") {
    assertEqual(repl("val o: Option[float] = 2.0\no\n"), "2.0")
}

test("the spec example session") {
    val input = "val x = 42\nx + 1\nfn greet(name: string): string { \"Hello, \$name!\" }\ngreet(\"World\")\nimport std/math { sqrt }\nsqrt(16.0)\nval xs = [1, 2, 3]\nxs\nval p = { name: \"Alice\", age: 30 }\np\ngreet\nx\nval x = \"now a string\"\nx\n"
    val expected = "43\n\"Hello, World!\"\n4.0\n[1, 2, 3]\n{ name: \"Alice\", age: 30 }\n<function greet(name: string): string>\n42\n\"now a string\""
    assertEqual(repl(input), expected)
}

summary()
