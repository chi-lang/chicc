import std/lang { embedLua, luaExpr }
import std/io.file { writeString, open }
import chicc/test_util { test, assertEqual, assertTrue, summary }
import chicc/cli { cliMain }

// Test cli.chi functions
// Tests for the CLI entry point module

// ============================================================================
// Tests for defaultOutputPath (via compileFile / internal logic)
// ============================================================================

// We test the public API functions that don't require file I/O

// ============================================================================
// Tests for hasErrors integration
// ============================================================================

test("cliMain with no args starts the REPL and returns 0") {
    // Per specs/cli, no arguments starts the interactive REPL.
    // Redirect stdin to /dev/null so the REPL sees immediate EOF and exits
    // cleanly with 0 (deterministic regardless of how the suite is invoked).
    embedLua("io.input('/dev/null')")
    val args: any = luaExpr("{}")
    val result = cliMain(args)
    assertEqual(result, 0)
}

test("cliMain with -h returns 0") {
    val args: any = luaExpr("{'-h'}")
    val result = cliMain(args)
    assertEqual(result, 0)
}

test("cliMain with --help returns 0") {
    val args: any = luaExpr("{'--help'}")
    val result = cliMain(args)
    assertEqual(result, 0)
}

test("cliMain compile without file returns 1") {
    val args: any = luaExpr("{'compile'}")
    val result = cliMain(args)
    assertEqual(result, 1)
}

test("cliMain compile with non-chi file returns 1") {
    val args: any = luaExpr("{'compile', 'file.txt'}")
    val result = cliMain(args)
    assertEqual(result, 1)
}

test("cliMain run without file returns 1") {
    val args: any = luaExpr("{'run'}")
    val result = cliMain(args)
    assertEqual(result, 1)
}

test("cliMain run with non-chi file returns 1") {
    val args: any = luaExpr("{'run', 'file.txt'}")
    val result = cliMain(args)
    assertEqual(result, 1)
}

test("cliMain unknown command returns 1") {
    val args: any = luaExpr("{'foobar'}")
    val result = cliMain(args)
    assertEqual(result, 1)
}

// ============================================================================
// Tests for compileFile with valid source
// ============================================================================

test("compileFile compiles simple source") {
    // Write a temp file
    embedLua("local f = io.open('/tmp/test_chicc_input.chi', 'w')")
    embedLua("f:write('val x = 42\\n')")
    embedLua("f:close()")

    loadStdlib()
    val result = compileFile("/tmp/test_chicc_input.chi", "/tmp/test_chicc_output.lua")
    assertEqual(result, 0)

    // Verify output file exists and contains Lua
    val output: string = luaExpr("(function() local f = io.open('/tmp/test_chicc_output.lua', 'r'); if f then local s = f:read('a'); f:close(); return s end; return '' end)()")
    val hasContent: bool = luaExpr("string.len(output) > 0")
    assertTrue(hasContent)

    // Clean up
    embedLua("os.remove('/tmp/test_chicc_input.chi')")
    embedLua("os.remove('/tmp/test_chicc_output.lua')")
}

test("compileFile returns 1 for invalid source") {
    // Write a temp file with invalid syntax
    embedLua("local f = io.open('/tmp/test_chicc_bad.chi', 'w')")
    embedLua("f:write('fn {')")
    embedLua("f:close()")

    loadStdlib()
    val result = compileFile("/tmp/test_chicc_bad.chi", "/tmp/test_chicc_bad.lua")
    assertEqual(result, 1)

    // Clean up
    embedLua("os.remove('/tmp/test_chicc_bad.chi')")
    embedLua("os.remove('/tmp/test_chicc_bad.lua')")
}

// ============================================================================
// Tests for runFile
// ============================================================================

test("runFile executes simple source") {
    embedLua("local f = io.open('/tmp/test_chicc_run.chi', 'w')")
    embedLua("f:write('val x = 42\\n')")
    embedLua("f:close()")

    loadStdlib()
    val result = runFile("/tmp/test_chicc_run.chi")
    assertEqual(result, 0)

    embedLua("os.remove('/tmp/test_chicc_run.chi')")
}

test("runFile returns 1 for invalid source") {
    embedLua("local f = io.open('/tmp/test_chicc_runbad.chi', 'w')")
    embedLua("f:write('fn {')")
    embedLua("f:close()")

    loadStdlib()
    val result = runFile("/tmp/test_chicc_runbad.chi")
    assertEqual(result, 1)

    embedLua("os.remove('/tmp/test_chicc_runbad.chi')")
}

// ============================================================================
// Unreadable inputs, unwritable outputs, extra inputs
// ============================================================================

test("cliMain run with missing file returns 1") {
    embedLua("os.remove('/tmp/test_chicc_missing.chi')")
    assertEqual(cliMain(["/tmp/test_chicc_missing.chi"]), 1)
}

test("cliMain compile with missing file returns 1") {
    embedLua("os.remove('/tmp/test_chicc_missing.chi')")
    assertEqual(cliMain(["compile", "/tmp/test_chicc_missing.chi"]), 1)
}

test("cliMain run with a directory as input returns 1") {
    embedLua("os.execute('mkdir -p /tmp/test_chicc_dir.chi')")
    assertEqual(cliMain(["/tmp/test_chicc_dir.chi"]), 1)
    embedLua("os.remove('/tmp/test_chicc_dir.chi')")
}

test("cliMain compile with unwritable output returns 1") {
    writeString("/tmp/test_chicc_ok.chi", "val x = 42\n")
    assertEqual(cliMain(["compile", "-o", "/nonexistent/dir/x.lua", "/tmp/test_chicc_ok.chi"]), 1)
    embedLua("os.remove('/tmp/test_chicc_ok.chi')")
}

test("cliMain compile with two inputs returns 1 and writes nothing") {
    writeString("/tmp/test_chicc_a.chi", "val a = 1\n")
    writeString("/tmp/test_chicc_b.chi", "val b = 2\n")
    embedLua("os.remove('/tmp/test_chicc_a.lua'); os.remove('/tmp/test_chicc_b.lua')")
    assertEqual(cliMain(["compile", "/tmp/test_chicc_a.chi", "/tmp/test_chicc_b.chi"]), 1)
    assertTrue(open("/tmp/test_chicc_a.lua", "r") == unit)
    assertTrue(open("/tmp/test_chicc_b.lua", "r") == unit)
    embedLua("os.remove('/tmp/test_chicc_a.chi'); os.remove('/tmp/test_chicc_b.chi')")
}

// ============================================================================
// build argument handling
// ============================================================================

type BuildCall = { input: string, luaCode: string, output: string }

// Stands in for the native launcher: marks the process as native and replaces
// chi_build with a stub recording each call.
fn stubNativeBuild(): array[BuildCall] {
    val calls: array[BuildCall] = []
    val stub = { input: string, luaCode: string, output: string ->
        calls.push({ input: input, luaCode: luaCode, output: output })
        0
    }
    embedLua("_CHI_NATIVE = true; chi_build = stub")
    calls
}

fn unstubNativeBuild() {
    embedLua("_CHI_NATIVE = nil; chi_build = nil")
}

test("cliMain build outside the native binary returns 1 without building") {
    val calls = stubNativeBuild()
    embedLua("_CHI_NATIVE = nil")
    writeString("/tmp/test_chicc_build.chi", "val x = 42\n")
    assertEqual(cliMain(["build", "/tmp/test_chicc_build.chi"]), 1)
    assertEqual(calls.size(), 0)
    unstubNativeBuild()
    embedLua("os.remove('/tmp/test_chicc_build.chi')")
}

test("cliMain build passes --output before the input to chi_build") {
    val calls = stubNativeBuild()
    writeString("/tmp/test_chicc_build.chi", "val x = 42\n")
    assertEqual(cliMain(["build", "--output", "/tmp/x", "/tmp/test_chicc_build.chi"]), 0)
    assertEqual(calls.size(), 1)
    assertEqual(calls[1].input, "/tmp/test_chicc_build.chi")
    assertEqual(calls[1].output, "/tmp/x")
    assertTrue(calls[1].luaCode.len() > 0)
    unstubNativeBuild()
    embedLua("os.remove('/tmp/test_chicc_build.chi')")
}

test("cliMain build passes --output after the input to chi_build") {
    val calls = stubNativeBuild()
    writeString("/tmp/test_chicc_build.chi", "val x = 42\n")
    assertEqual(cliMain(["build", "/tmp/test_chicc_build.chi", "--output", "x"]), 0)
    assertEqual(calls.size(), 1)
    assertEqual(calls[1].input, "/tmp/test_chicc_build.chi")
    assertEqual(calls[1].output, "x")
    unstubNativeBuild()
    embedLua("os.remove('/tmp/test_chicc_build.chi')")
}

test("cliMain build passes -o to chi_build") {
    val calls = stubNativeBuild()
    writeString("/tmp/test_chicc_build.chi", "val x = 42\n")
    assertEqual(cliMain(["build", "-o", "y", "/tmp/test_chicc_build.chi"]), 0)
    assertEqual(calls.size(), 1)
    assertEqual(calls[1].output, "y")
    unstubNativeBuild()
    embedLua("os.remove('/tmp/test_chicc_build.chi')")
}

test("cliMain build defaults the output to the input without .chi") {
    val calls = stubNativeBuild()
    writeString("/tmp/test_chicc_build.chi", "val x = 42\n")
    assertEqual(cliMain(["build", "/tmp/test_chicc_build.chi"]), 0)
    assertEqual(calls.size(), 1)
    assertEqual(calls[1].output, "/tmp/test_chicc_build")
    unstubNativeBuild()
    embedLua("os.remove('/tmp/test_chicc_build.chi')")
}

test("cliMain build accepts a non-ASCII input path") {
    val calls = stubNativeBuild()
    writeString("/tmp/test_chicc_żółw.chi", "val x = 42\n")
    assertEqual(cliMain(["build", "/tmp/test_chicc_żółw.chi"]), 0)
    assertEqual(calls.size(), 1)
    assertEqual(calls[1].output, "/tmp/test_chicc_żółw")
    unstubNativeBuild()
    embedLua("os.remove('/tmp/test_chicc_żółw.chi')")
}

test("cliMain build rejects bad arguments without building") {
    val calls = stubNativeBuild()
    writeString("/tmp/test_chicc_build.chi", "val x = 42\n")
    writeString("/tmp/test_chicc_build.txt", "val x = 42\n")
    embedLua("os.remove('/tmp/test_chicc_missing.chi')")
    assertEqual(cliMain(["build"]), 1)
    assertEqual(cliMain(["build", "/tmp/test_chicc_build.txt"]), 1)
    assertEqual(cliMain(["build", "-o"]), 1)
    assertEqual(cliMain(["build", "/tmp/test_chicc_build.chi", "-o"]), 1)
    assertEqual(cliMain(["build", "/tmp/test_chicc_build.chi", "--output"]), 1)
    assertEqual(cliMain(["build", "-o", "y"]), 1)
    assertEqual(cliMain(["build", "/tmp/test_chicc_build.chi", "/tmp/test_chicc_build.chi"]), 1)
    assertEqual(cliMain(["build", "/tmp/test_chicc_missing.chi"]), 1)
    assertEqual(calls.size(), 0)
    unstubNativeBuild()
    embedLua("os.remove('/tmp/test_chicc_build.chi'); os.remove('/tmp/test_chicc_build.txt')")
}

test("cliMain build does not build source that fails to compile") {
    val calls = stubNativeBuild()
    writeString("/tmp/test_chicc_build_bad.chi", "fn {")
    assertEqual(cliMain(["build", "/tmp/test_chicc_build_bad.chi"]), 1)
    assertEqual(calls.size(), 0)
    unstubNativeBuild()
    embedLua("os.remove('/tmp/test_chicc_build_bad.chi')")
}

// ============================================================================
// Tests for loadStdlib
// ============================================================================

test("loadStdlib returns true when CHI_HOME is set") {
    val hasHome: bool = luaExpr("os.getenv('CHI_HOME') ~= nil")
    if hasHome {
        val result = loadStdlib()
        assertTrue(result)
    } else {
        // Skip test if CHI_HOME not set
        assertTrue(true)
    }
}

summary()
