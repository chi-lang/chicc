import chicc/test_util { test, assertEqual, assertFalse, summary }
import chicc/token { newToken, lookupKeyword, tokenKindName, describeToken, TK_INT, TK_FLOAT, TK_STRING, TK_INTERP_START, TK_INTERP_TEXT, TK_INTERP_EXPR_START, TK_INTERP_EXPR_END, TK_INTERP_END, TK_ID, TK_PUB, TK_VAL, TK_VAR, TK_FN, TK_IF, TK_ELSE, TK_AS, TK_WHILE, TK_FOR, TK_IN, TK_PACKAGE, TK_IMPORT, TK_DATA, TK_WHEN, TK_MATCH, TK_IS, TK_BREAK, TK_CONTINUE, TK_EFFECT, TK_HANDLE, TK_WITH, TK_RETURN, TK_TRAIT, TK_TYPE, TK_TRUE, TK_FALSE, TK_UNIT, TK_PLUS, TK_MINUS, TK_STAR, TK_SLASH, TK_PERCENT, TK_EQ, TK_EQEQ, TK_NEQ, TK_LT, TK_LTEQ, TK_GT, TK_GTEQ, TK_NOT, TK_AND, TK_OR, TK_AMP, TK_PIPE, TK_LSHIFT, TK_RSHIFT, TK_ARROW, TK_WEAVE, TK_UNDERSCORE, TK_DOT, TK_COMMA, TK_COLON, TK_PLUSEQ, TK_MINUSEQ, TK_STAREQ, TK_SLASHEQ, TK_LPAREN, TK_RPAREN, TK_LBRACE, TK_RBRACE, TK_LBRACKET, TK_RBRACKET, TK_EOF, TK_NEWLINE }
import chicc/source { newSection }

test("newToken") {
    val t = newToken(TK_INT, "42", unit)
    assertEqual(t.kind, TK_INT)
    assertEqual(t.value, "42")
}

test("newToken with section") {
    val s = newSection(1, 1, 1, 3)
    val t = newToken(TK_INT, "42", s)
    assertEqual(t.kind, TK_INT)
    assertEqual(t.value, "42")
}

test("lookupKeyword known") {
    assertEqual(lookupKeyword("pub"), TK_PUB)
    assertEqual(lookupKeyword("fn"), TK_FN)
    assertEqual(lookupKeyword("if"), TK_IF)
    assertEqual(lookupKeyword("while"), TK_WHILE)
    assertEqual(lookupKeyword("return"), TK_RETURN)
    assertEqual(lookupKeyword("type"), TK_TYPE)
    assertEqual(lookupKeyword("true"), TK_TRUE)
    assertEqual(lookupKeyword("false"), TK_FALSE)
    assertEqual(lookupKeyword("unit"), TK_UNIT)
}

test("lookupKeyword unknown") {
    assertEqual(lookupKeyword("foo"), TK_ID)
    assertEqual(lookupKeyword("myVar"), TK_ID)
    assertEqual(lookupKeyword("x"), TK_ID)
}

// Syntax errors name token kinds the way a user writes them (#33).
test("tokenKindName quotes punctuation and keywords") {
    assertEqual(tokenKindName(TK_ARROW), "'->'")
    assertEqual(tokenKindName(TK_RBRACE), "'}'")
    assertEqual(tokenKindName(TK_FN), "'fn'")
    assertEqual(tokenKindName(TK_INTERP_EXPR_END), "'}'")
}

test("tokenKindName names literal kinds and line structure") {
    assertEqual(tokenKindName(TK_ID), "identifier")
    assertEqual(tokenKindName(TK_INT), "integer")
    assertEqual(tokenKindName(TK_STRING), "string")
    assertEqual(tokenKindName(TK_NEWLINE), "end of line")
    assertEqual(tokenKindName(TK_EOF), "end of file")
}

test("tokenKindName covers every token kind") {
    val kinds = [TK_INT, TK_FLOAT, TK_STRING, TK_INTERP_START, TK_INTERP_TEXT, TK_INTERP_EXPR_START, TK_INTERP_EXPR_END, TK_INTERP_END,
        TK_ID, TK_PUB, TK_VAL, TK_VAR, TK_FN, TK_IF, TK_ELSE, TK_AS, TK_WHILE, TK_FOR, TK_IN, TK_PACKAGE, TK_IMPORT, TK_DATA,
        TK_WHEN, TK_MATCH, TK_IS, TK_BREAK, TK_CONTINUE, TK_EFFECT, TK_HANDLE, TK_WITH, TK_RETURN, TK_TRAIT, TK_TYPE,
        TK_TRUE, TK_FALSE, TK_UNIT,
        TK_PLUS, TK_MINUS, TK_STAR, TK_SLASH, TK_PERCENT, TK_EQ, TK_EQEQ, TK_NEQ, TK_LT, TK_LTEQ, TK_GT, TK_GTEQ, TK_NOT,
        TK_AND, TK_OR, TK_AMP, TK_PIPE, TK_LSHIFT, TK_RSHIFT, TK_ARROW, TK_WEAVE, TK_UNDERSCORE, TK_DOT, TK_COMMA, TK_COLON,
        TK_PLUSEQ, TK_MINUSEQ, TK_STAREQ, TK_SLASHEQ,
        TK_LPAREN, TK_RPAREN, TK_LBRACE, TK_RBRACE, TK_LBRACKET, TK_RBRACKET, TK_EOF, TK_NEWLINE]
    for kind in kinds {
        assertFalse(tokenKindName(kind) == tokenKindName(0))
    }
}

test("describeToken quotes the source text of names and numbers") {
    assertEqual(describeToken(newToken(TK_ID, "println", unit)), "'println'")
    assertEqual(describeToken(newToken(TK_INT, "42", unit)), "'42'")
    assertEqual(describeToken(newToken(TK_RPAREN, ")", unit)), "')'")
}

test("describeToken never shows a raw newline or empty text") {
    assertEqual(describeToken(newToken(TK_NEWLINE, "\n", unit)), "end of line")
    assertEqual(describeToken(newToken(TK_EOF, "", unit)), "end of file")
    assertEqual(describeToken(newToken(TK_INTERP_EXPR_END, "", unit)), "'}'")
}

summary()
